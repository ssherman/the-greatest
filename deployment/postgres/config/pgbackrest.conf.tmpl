# pgbackrest.conf template. A deploy step renders the ${VAR} placeholders from SOPS-managed
# environment into /srv/postgres/config/pgbackrest.conf. Spec §8.1.
[global]
repo1-type=s3
repo1-s3-bucket=${PGBACKREST_REPO_BUCKET}
repo1-s3-endpoint=${PGBACKREST_REPO_ENDPOINT}
repo1-s3-region=${PGBACKREST_REPO_REGION}
repo1-path=${PGBACKREST_REPO_PATH}
repo1-s3-key=${PGBACKREST_REPO_KEY}
repo1-s3-key-secret=${PGBACKREST_REPO_KEY_SECRET}
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=${PGBACKREST_CIPHER_PASS}
repo1-retention-full-type=time
repo1-retention-full=30
compress-type=zst
process-max=1
start-fast=n
log-level-console=warn

[main]
pg1-path=/var/lib/postgresql/18/docker
