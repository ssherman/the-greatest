# deployment/postgres/.env.postgres.example -- the shape of secrets/.env.postgres (SOPS-encrypted).
# Every value here is a placeholder. Real values live only in the encrypted file.
# Generate each password with: openssl rand -hex 32

# One `role database address` entry per login and client server, separated by semicolons. Allowed
# pairs: the_greatest/the_greatest, tgb_app/tgb, tgb_reader/tgb. Single host addresses only, IPv4: the port binds
# IPv4 only, so an IPv6 client can never connect (render-hba.sh warns on one).
# The firewall allowlist is the unique addresses in this list.
POSTGRES_CLIENTS="the_greatest the_greatest 192.0.2.10;tgb_app tgb 192.0.2.20;tgb_reader tgb 192.0.2.10"

# Used by the image on first init; never over the network.
POSTGRES_SUPERUSER_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_THE_GREATEST_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_TGB_APP_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_TGB_READER_PASSWORD=replace-with-openssl-rand-hex-32

# pgBackRest repository: the R2 backups bucket, through R2's S3 API. The endpoint is
# <account id>.r2.cloudflarestorage.com with no scheme, and the region is always `auto`. The key is
# the server's R2 token (Object Read & Write on this bucket only): key = the token's id, secret =
# the SHA-256 of the token's value. setup-r2.sh reads the bucket and path from here too, to place
# the lock on <path>/archive/main/18-. The cipher pass encrypts the repo: losing it loses the backups.
PGBACKREST_REPO_BUCKET=example-bucket
PGBACKREST_REPO_ENDPOINT=example-account-id.r2.cloudflarestorage.com
PGBACKREST_REPO_REGION=auto
PGBACKREST_REPO_PATH=/example-path
PGBACKREST_REPO_KEY=replace-with-r2-token-id
PGBACKREST_REPO_KEY_SECRET=replace-with-sha256-of-r2-token-value
PGBACKREST_CIPHER_PASS=replace-with-openssl-rand-hex-32

# Healthchecks.io ping URLs for the backup and the backup-health timers.
HC_PG_BACKUP=https://hc-ping.example.invalid/replace-with-uuid
HC_PG_HEALTH=https://hc-ping.example.invalid/replace-with-uuid

# Not set in normal operation. See deploy.sh: POSTGRES_BOOTSTRAP is a one-time choice on a rebuilt
# server (restore or new-cluster); POSTGRES_ALLOW_RESTART=1 permits the restart a changed image needs.
# POSTGRES_BOOTSTRAP=
# POSTGRES_ALLOW_RESTART=
