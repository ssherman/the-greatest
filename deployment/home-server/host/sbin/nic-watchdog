#!/usr/bin/env bash
# deployment/home-server/host/sbin/nic-watchdog
# Runs once a minute on the Proxmox host. When the gateway is lost, with or without kernel "Detected
# Hardware Unit Hang" messages for the uplink NIC, it resets the card, and reboots the host only if
# resetting did not help. A wrong reboot restarts every VM, so every reboot is gated by a 6 hour
# limit, and the decision order below is deliberate.
#
# The rule above all others, from the owner: never restart a healthy server. try_reboot holds the
# only `systemctl reboot` in this file and runs a fresh gateway check immediately before it. An
# answering gateway vetoes the reboot, whatever led there, and no reboot happens within MOVE_WAIT of
# any link command, because that command can be why pings fail. While the gateway answers the
# watchdog never starts a reset: hang messages alone are logged and reported, nothing more.
#
# Deliberately no `set -e`: a failed read must be seen and handled, never stop the script
# partway through a sequence. All logging is plain stdout; the service's SyslogIdentifier tags it.
set -uo pipefail

GATEWAY_RESET_1=300     # gateway lost this long: first reset
GATEWAY_RESET_2=900     # ... second reset
GATEWAY_REBOOT=1800     # ... then try a reboot
RETRY_RESET=1800        # a refused reboot retries a reset at most this often
REBOOT_LIMIT=21600      # never reboot twice inside this window
STALE_GAP=300           # a check this long after the previous one starts a new episode
MOVE_WAIT=300           # no reboot this long after any link command

ENV_FILE="${NIC_WATCHDOG_ENV:-/etc/the-greatest-home-server/nic-watchdog.env}"
LOG_ONLY_FILE="${NIC_WATCHDOG_LOG_ONLY_FILE:-/etc/the-greatest-home-server/nic-watchdog-log-only}"
STATE="${NIC_WATCHDOG_STATE:-/var/lib/nic-watchdog}"   # survives reboot
RUN="${NIC_WATCHDOG_RUN:-/run/nic-watchdog}"           # clears on boot
SYS="${NIC_WATCHDOG_SYS:-/sys/class/net}"
NOW="${NIC_WATCHDOG_NOW:-$(date +%s)}"
UPTIME_FILE="${NIC_WATCHDOG_UPTIME:-/proc/uptime}"
LINK_COMMAND_LIMIT=10       # seconds an ip link command, a carrier read or a route read may take
[[ ${NIC_WATCHDOG_LINK_LIMIT:-} =~ ^[1-9][0-9]*$ ]] && LINK_COMMAND_LIMIT="$NIC_WATCHDOG_LINK_LIMIT"
PING_LIMIT=15               # seconds a ping may take; -c 3 -W 2 needs about 4 at worst
[[ ${NIC_WATCHDOG_PING_LIMIT:-} =~ ^[1-9][0-9]*$ ]] && PING_LIMIT="$NIC_WATCHDOG_PING_LIMIT"
JOURNAL_LIMIT=30            # seconds journalctl may take; an overrun stops the check, so this is generous
[[ ${NIC_WATCHDOG_JOURNAL_LIMIT:-} =~ ^[1-9][0-9]*$ ]] && JOURNAL_LIMIT="$NIC_WATCHDOG_JOURNAL_LIMIT"
GATE_SECOND_ROUND_WAIT=20   # seconds between the gate's two ping rounds
[[ ${NIC_WATCHDOG_GATE_WAIT:-} =~ ^[0-9]+$ ]] && GATE_SECOND_ROUND_WAIT="$NIC_WATCHDOG_GATE_WAIT"

log() { echo "$*"; }

# The env file is parsed for two keys, never sourced.
NIC=""
HC=""
if [ -r "$ENV_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      NIC=*) NIC="${line#NIC=}" ;;
      HC_NIC_WATCHDOG=*) HC="${line#HC_NIC_WATCHDOG=}" ;;
    esac
  done <"$ENV_FILE"
fi
NIC="${NIC//[\"\']/}"
HC="${HC//[\"\']/}"
HC="${HC%/}"
if ! [[ $NIC =~ ^[A-Za-z0-9._-]+$ ]]; then
  log "NIC missing or invalid in the env file; doing nothing"
  exit 1
fi
if ! [[ $NOW =~ ^[0-9]+$ ]]; then
  log "NIC_WATCHDOG_NOW is not an epoch; doing nothing"
  exit 1
fi

# Log-only mode keeps its episode in a directory of its own. It counts resets it never did and runs
# a clock nobody acted on, so none of that can reach a real check.
LOG_ONLY=0
if [ -e "$LOG_ONLY_FILE" ]; then
  LOG_ONLY=1
  RUN="$RUN/log-only"
fi

# num <file>: print the file's value only if it is a non-negative integer.
num() {
  local v=""
  [ -r "$1" ] || return 1
  IFS= read -r v <"$1" 2>/dev/null || [ -n "$v" ] || return 1
  [[ $v =~ ^(0|[1-9][0-9]{0,17})$ ]] || return 1
  printf '%s' "$v"
}
put() { { printf '%s\n' "$2" >"$1"; } 2>/dev/null; }
# last_link_move is not episode state: a port moved just before an episode ended can still be down.
clear_episode() { rm -f "$RUN/hang_streak" "$RUN/hang_seen" "$RUN/hang_reported" "$RUN/gateway_lost_since" "$RUN/resets" "$RUN/last_reset"; }
now_iso() { date -u -d "@$NOW" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "$NOW"; }
report() {
  [ "$LOG_ONLY" = 1 ] && return 0
  { printf '%s %s\n' "$(now_iso)" "$1" >>"$STATE/report"; } 2>/dev/null && return 0
  log "cannot write the report"
  return 1
}

mkdir -p "$RUN" "$STATE" 2>/dev/null
# Without a writable state directory no reboot can record itself and no success ping can be spaced
# out: the reboot is refused where its write fails, and send_report stays quiet so the check alerts.
state_ok() { [ -d "$STATE" ] && [ -w "$STATE" ]; }
state_ok || log "cannot write $STATE; no reboot and no success ping until it can"
if ! [ -d "$RUN" ] || ! [ -w "$RUN" ]; then
  log "cannot write $RUN; doing nothing"
  exit 1
fi

# uptime_cs: set UP_CS to the time since boot in hundredths of a second. The uptime clock cannot be
# stepped, so a clock change can neither fake nor hide an overrun. Parsed as text, in base 10: no
# locale touches it, and a fraction like "08" is not octal.
uptime_cs() {
  local line=""
  [ -r "$UPTIME_FILE" ] || return 1
  IFS= read -r line <"$UPTIME_FILE" 2>/dev/null || return 1
  [[ $line =~ ^([0-9]+)[.,]([0-9]{2}) ]] || return 1
  UP_CS=$((10#${BASH_REMATCH[1]}${BASH_REMATCH[2]}))
}

# limited <limit-seconds> <outfile> <command...>: run a command in the background and wait for it
# at most <limit> seconds, polling with kill -0. Returns the command's status, 124 if it overran
# (with the command's pid in LIMITED_PID), or 125 if the outfile cannot be written, so the command
# never ran: a redirect that fails in the background looks exactly like a command exiting 1. An
# overrun is NOT reaped: a command stuck in the driver (holding RTNL) cannot be killed, and waiting
# for it would hang this script too.
# The outfile is unlinked first, so a leftover from an earlier overrun that wakes up later writes to
# a file nobody reads and cannot pass for this command's output. Never give it /dev/null.
# Without a readable uptime clock the polls themselves bound the wait: each sleeps at least 0.1s.
limited() {
  local limit="$1" out="$2" pid start="" polls=0 UP_CS=0
  shift 2
  uptime_cs && start="$UP_CS"
  rm -f "$out" 2>/dev/null
  { : >"$out"; } 2>/dev/null || return 125
  "$@" >"$out" 2>/dev/null </dev/null &
  pid=$!
  LIMITED_PID="$pid"
  while kill -0 "$pid" 2>/dev/null; do
    polls=$((polls + 1))
    if [ -n "$start" ] && uptime_cs; then
      if [ $((UP_CS - start)) -ge $((limit * 100)) ]; then return 124; fi
    elif [ "$polls" -ge $((limit * 10)) ]; then
      return 124
    fi
    sleep 0.1
  done
  wait "$pid"
}
# limited_read: limited, for a command that only reads (carrier, route, ping, journal). An overrun gets kill -9,
# so a read that stays stuck does not leave one process per check, unless it is in uninterruptible
# sleep, which survives even that. Never use this for ip link: reset_wedged depends on a stuck link
# command staying alive.
limited_read() {
  local rc
  limited "$@"; rc=$?
  if [ "$rc" = 124 ]; then
    kill -9 "$LIMITED_PID" 2>/dev/null
    disown "$LIMITED_PID" 2>/dev/null
  fi
  return "$rc"
}
# shellcheck disable=SC2329  # run through limited, which shellcheck cannot follow
read_carrier() { local c; read -r c <"$SYS/$NIC/carrier" || return 1; printf '%s\n' "$c"; }
# read_route: set GW to the gateway of the default route through vmbr0, and remember it. Returns 0, or
# limited's status, or 1 if there is no such route: a ping through vmbr0 says nothing about a gateway on
# another device. A read that overruns falls back on the remembered gateway, because whatever holds the
# route read can be the fault that needs recovering from. With nothing remembered it stays unknown.
read_route() {
  local rc dflt via gw dev on _
  GW=""
  limited_read "$LINK_COMMAND_LIMIT" "$RUN/limited.out" ip -4 route show default; rc=$?
  if [ "$rc" = 124 ]; then
    log "reading the default route did not finish in ${LINK_COMMAND_LIMIT}s"
    report "reading the default route did not finish in ${LINK_COMMAND_LIMIT}s"
    { IFS= read -r gw <"$RUN/gateway"; } 2>/dev/null || return 124
    [[ ${gw:-} =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 124
    GW="$gw"
    return 0
  fi
  [ "$rc" = 0 ] || return "$rc"
  read -r dflt via gw dev on _ <"$RUN/limited.out"
  [ "${dflt:-}" = default ] && [ "${via:-}" = via ] && [ "${dev:-}" = dev ] && [ "${on:-}" = vmbr0 ] &&
    [[ ${gw:-} =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  GW="$gw"
  put "$RUN/gateway" "$gw"
}
ping_gateway() { limited_read "$PING_LIMIT" "$RUN/limited.out" ping -c 3 -W 2 -I vmbr0 "$GW"; }
# wait_for_carrier: up to 15 seconds. Returns 0 back, 1 not back, 124 a read overran. WAITED holds
# the seconds it took.
wait_for_carrier() {
  local rc c
  for ((WAITED = 0; WAITED < 15; WAITED++)); do
    c=""
    limited_read "$LINK_COMMAND_LIMIT" "$RUN/limited.out" read_carrier; rc=$?
    if [ "$rc" = 124 ]; then return 124; fi
    [ "$rc" = 0 ] && c=$(<"$RUN/limited.out")
    if [ "$c" = 1 ]; then return 0; fi
    sleep 1
  done
  return 1
}

# proc_start <pid>: print a live process's start time (field 22 of /proc/<pid>/stat), the part of its
# identity a reused pid cannot share. A zombie has finished, so it counts as gone. The command name
# can hold spaces and parentheses, so fields are counted from after the last ")".
proc_start() {
  local stat="" rest
  local -a fields
  { IFS= read -r stat <"/proc/$1/stat"; } 2>/dev/null || return 1
  rest="${stat##*) }"
  read -ra fields <<<"$rest"
  [ "${fields[0]:-Z}" != Z ] || return 1
  [[ ${fields[19]:-} =~ ^[0-9]+$ ]] || return 1
  printf '%s' "${fields[19]}"
}

# reset_wedged names one stuck link command: its pid, its start time and whether it was the down or
# the up. Only a stuck link command writes it, and only a boot or that command finishing removes it;
# clear_episode does not touch it. A file this cannot read counts as naming a finished command.
mark_wedged() { # mark_wedged <down|up> <pid>
  local start
  start=$(proc_start "$2") || start=""
  printf 'pid=%s\nwhat=%s\nstart=%s\n' "$2" "$1" "$start" >"$RUN/reset_wedged" 2>/dev/null || log "cannot write reset_wedged"
}
read_wedge() { # sets WEDGE_PID, WEDGE_WHAT (down, up or empty) and WEDGE_START
  local line
  WEDGE_PID="" WEDGE_WHAT="" WEDGE_START=""
  [ -f "$RUN/reset_wedged" ] && [ -r "$RUN/reset_wedged" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      pid=*) WEDGE_PID="${line#pid=}" ;;
      what=down) WEDGE_WHAT=down ;;
      what=up) WEDGE_WHAT=up ;;
      start=*) WEDGE_START="${line#start=}" ;;
    esac
  done <"$RUN/reset_wedged"
}
wedge_alive() { # true only if the named process is still running and is still the same process
  read_wedge
  [[ $WEDGE_PID =~ ^[1-9][0-9]*$ ]] && [[ $WEDGE_START =~ ^[0-9]+$ ]] || return 1
  [ "$(proc_start "$WEDGE_PID")" = "$WEDGE_START" ]
}

# up_seconds: set UP_S to whole seconds since boot, the clock of the move marker. A wall-clock step
# cannot move it, and $RUN clears on boot, so a stamp never outlives its clock. NIC_WATCHDOG_BOOT_NOW
# pins it for tests, which cannot move the real one.
up_seconds() {
  local UP_CS
  if [[ ${NIC_WATCHDOG_BOOT_NOW:-} =~ ^[0-9]+$ ]]; then
    UP_S="$NIC_WATCHDOG_BOOT_NOW"
    return 0
  fi
  uptime_cs || return 1
  UP_S=$((UP_CS / 100))
}
# stamp_move: record that a link command is about to run. Fails if it cannot, and the caller then
# refuses the move: a move nobody recorded could fail a later ping with no refusal to catch it.
stamp_move() {
  if up_seconds && put "$RUN/last_link_move" "$UP_S"; then return 0; fi
  log "cannot record a link move; refusing it"
  return 1
}
# moved_within <seconds>: did a link command start this recently? An unreadable or future stamp counts
# as just now and is rewritten, so a damaged file cannot void the refusal or hold it forever.
moved_within() {
  local move
  [ -e "$RUN/last_link_move" ] || return 1
  up_seconds || return 0
  if ! move=$(num "$RUN/last_link_move") || [ "$move" -gt "$UP_S" ]; then
    put "$RUN/last_link_move" "$UP_S"
    return 0
  fi
  [ $((UP_S - move)) -lt "$1" ]
}
# link_cmd <down|up>: the one place a link command runs, stamped by the caller. Returns 0, 1 if it
# failed, or 124 if it overran: it stays running, reset_wedged names it, and the next check takes over.
link_cmd() {
  local rc cmd="ip link set $NIC $1"
  limited "$LINK_COMMAND_LIMIT" "$RUN/limited.out" ip link set "$NIC" "$1"; rc=$?
  [ "$rc" = 0 ] && return 0
  if [ "$rc" = 124 ]; then
    log "$cmd did not finish in ${LINK_COMMAND_LIMIT}s; it may be stuck in the driver"
    report "$cmd did not finish in ${LINK_COMMAND_LIMIT}s"
    mark_wedged "$1" "$LIMITED_PID"
    return 124
  fi
  log "$cmd failed"
  return 1
}

do_reset() { # do_reset <why>; a refused move does not count, so the sequence has not advanced
  local outcome="" rc linkfail=0
  stamp_move || return 0
  # Count first, so a kill mid-reset still advances the sequence.
  resets=$((resets + 1))
  put "$RUN/resets" "$resets"
  if [ "$LOG_ONLY" = 1 ]; then
    log "would reset $NIC ($1)"
  else
    log "resetting $NIC ($1)"
    link_cmd down; rc=$?
    if [ "$rc" = 124 ]; then return 0; fi
    if [ "$rc" != 0 ]; then linkfail=1; fi
    sleep 3
    # This stamp may fail and the up still runs: the down's stamp is seconds old, and this reset took
    # the port down, so it must try to bring it back.
    stamp_move
    link_cmd up; rc=$?
    if [ "$rc" = 124 ]; then return 0; fi
    if [ "$rc" != 0 ]; then linkfail=1; fi
    wait_for_carrier; rc=$?
    if [ "$linkfail" = 1 ]; then
      outcome="ip link failed"
    elif [ "$rc" = 0 ]; then
      outcome="carrier back after ${WAITED}s"
    elif [ "$rc" = 124 ]; then
      # Says nothing about the card by itself: no flag and no reboot. The next check decides.
      outcome="carrier read did not finish in ${LINK_COMMAND_LIMIT}s"
    else
      outcome="carrier not back after 15s"
    fi
    log "reset of $NIC finished: $outcome"
  fi
  # The reset's own time, after the link is back: hang messages from before it are not a failed
  # reset. SECONDS keeps the test clock (NIC_WATCHDOG_NOW) working.
  put "$RUN/last_reset" "$((NOW + SECONDS))"
  report "reset $NIC ($1)${outcome:+: $outcome}"
}

# An unknown result says nothing about the gateway, so the time before it cannot count as lost.
restart_gateway_clock() { rm -f "$RUN/gateway_lost_since"; }
# The gateway answered: the outage is over, so the next one starts its sequence from the beginning.
gateway_answered() {
  rm -f "$RUN/gateway_lost_since" "$RUN/resets" "$STATE/gateway_reboot_marker"
  send_report
}

# gate_allows_reboot <reason>: the final say, run immediately before every reboot. Returns 0 only if
# the reboot may go ahead, with GATE_DETAIL saying why. It decides on what it reads now:
#   the gateway answers either round       never reboot
#   no reply on both rounds (ping exit 1)  may reboot
#   anything else, or a read that overran  may reboot only with direct evidence the port is down
#   a check that could not run at all      never reboot: the gateway must have been asked
# and in every case not within MOVE_WAIT of a link command. A carrier read that overruns is not
# evidence of anything.
gate_allows_reboot() {
  local reason="$1" rc unknown="" evidence=""
  read_route; rc=$?
  if [ "$rc" = 0 ]; then
    ping_gateway; rc=$?
    # One lost round can be a blip, and a reboot cannot be taken back, so a second round must agree. It
    # is treated exactly like the first: an answer vetoes, and any other status is unknown.
    if [ "$rc" = 1 ]; then
      sleep "$GATE_SECOND_ROUND_WAIT"
      ping_gateway; rc=$?
    fi
    case "$rc" in
      0)
        log "reboot vetoed ($reason): the gateway answered a fresh check"
        gateway_answered
        return 1
        ;;
      1) GATE_DETAIL="gateway gave no reply on two rounds" ;;
      124)
        unknown="ping did not finish in ${PING_LIMIT}s"
        report "$unknown"
        ;;
      *) unknown="ping exited $rc" ;;
    esac
  elif [ "$rc" = 124 ]; then
    unknown="reading the default route did not finish in ${LINK_COMMAND_LIMIT}s"
  else
    unknown="no default route on vmbr0"
  fi
  # 125 is a redirect that failed, 126 and 127 a command that would not start.
  case "$rc" in
    125 | 126 | 127)
      log "reboot refused ($reason): could not run the gateway check (status $rc)"
      restart_gateway_clock
      return 1
      ;;
  esac
  if [ -n "$unknown" ]; then
    if wedge_alive; then
      evidence="a link command is stuck"
    elif [ -e "$SYS/$NIC/carrier" ]; then
      limited_read "$LINK_COMMAND_LIMIT" "$RUN/limited.out" read_carrier; rc=$?
      if [ "$rc" = 124 ]; then
        log "carrier read for $NIC did not finish in ${LINK_COMMAND_LIMIT}s; that is not evidence"
        report "carrier read on $NIC did not finish in ${LINK_COMMAND_LIMIT}s"
      elif [ "$rc" = 1 ]; then
        evidence="the interface is administratively down"
      elif [ "$rc" = 0 ] && [ "$(<"$RUN/limited.out")" = 0 ]; then
        evidence="carrier reads 0"
      fi
    fi
    if [ -z "$evidence" ]; then
      log "reboot refused ($reason): $unknown, and no direct evidence the port is down"
      restart_gateway_clock
      return 1
    fi
    GATE_DETAIL="$unknown, and $evidence"
  fi
  # Asked after the ping, so an answering gateway still vetoes and still gets the report out.
  if moved_within "$MOVE_WAIT"; then
    log "reboot refused ($reason): a link command ran under ${MOVE_WAIT}s ago"
    return 1
  fi
  return 0
}

# try_reboot <hang|gateway> [noreset] [reason]: returns 0 only if systemctl reboot ran and succeeded.
# The kind picks the rules (the gateway kind obeys the marker); the reason is what the log and the
# report name, so a reboot with no hang behind it does not say "hang".
try_reboot() {
  local kind="$1" reason="${3:-$1}" last why=""
  if last=$(num "$STATE/last_reboot") && [ "$last" -le "$NOW" ]; then
    if [ $((NOW - last)) -lt "$REBOOT_LIMIT" ]; then why="last reboot was $((NOW - last))s ago"; fi
  elif [ -e "$STATE/last_reboot" ]; then
    why="last_reboot is unreadable or in the future"
    [ "$LOG_ONLY" = 1 ] || put "$STATE/last_reboot" "$NOW"
  fi
  if [ -z "$why" ] && [ "$kind" = gateway ] && [ -e "$STATE/gateway_reboot_marker" ]; then
    why="a gateway reboot already happened and the gateway has not answered since"
  fi
  if [ -n "$why" ]; then
    log "reboot refused ($reason): $why"
    local lr
    if [ "${2:-}" != noreset ]; then
      if ! lr=$(num "$RUN/last_reset") || [ $((NOW - lr)) -ge "$RETRY_RESET" ]; then
        do_reset "retry after refused reboot"
      fi
    fi
    return 1
  fi
  # The one way to a reboot. Nothing below this line runs if the gate refuses.
  gate_allows_reboot "$reason" || return 1
  if [ "$LOG_ONLY" = 1 ]; then
    log "would reboot ($reason): $GATE_DETAIL"
    return 1
  fi
  # last_reboot first: if it cannot land the limit cannot hold, so no reboot. After that a stopped or
  # failed reboot keeps it, which only ever means fewer reboots. The marker must land too, or a dead
  # router gets one reboot per limit. The report is only news, and the journal has it anyway.
  put "$STATE/last_reboot" "$NOW" || { log "cannot write last_reboot; not rebooting"; return 1; }
  if [ "$kind" = gateway ]; then
    { : >"$STATE/gateway_reboot_marker"; } 2>/dev/null || { log "cannot write the marker; not rebooting"; return 1; }
  fi
  report "reboot ($reason): $GATE_DETAIL"
  log "rebooting ($reason): $GATE_DETAIL"
  if ! systemctl reboot; then
    log "systemctl reboot failed"
    report "reboot failed ($reason)"
    return 1
  fi
  return 0
}

send_report() { # only called on a check where the gateway answered
  [ -n "$HC" ] || return 0
  local lp
  if [ -e "$STATE/report" ]; then
    if curl -fsS -m 10 -o /dev/null --data-binary "@$STATE/report" "$HC/fail" 2>/dev/null; then
      rm -f "$STATE/report"
      log "report sent"
    else
      log "report send failed"
    fi
  elif ! state_ok; then
    return 0   # could not record the ping, so it would repeat every minute
  elif ! lp=$(num "$STATE/last_ping") || [ "$lp" -gt "$NOW" ] || [ $((NOW - lp)) -ge 3600 ]; then
    if curl -fsS -m 10 -o /dev/null "$HC" 2>/dev/null; then
      put "$STATE/last_ping" "$NOW"
      log "ping sent"
    else
      log "ping failed"
    fi
  fi
}


# 1. Stale state: a gap in checks (pause, reboot, clock jump) ends the episode.
prev=""
if [ -e "$RUN/last_check" ]; then
  if prev=$(num "$RUN/last_check") && [ "$prev" -le "$NOW" ] && [ $((NOW - prev)) -le "$STALE_GAP" ]; then
    :
  else
    log "previous check is stale or in the future; discarding episode state"
    clear_episode
    prev=""
  fi
fi
if ! put "$RUN/last_check" "$NOW"; then
  log "cannot record this check; doing nothing"
  exit 1
fi

# 1b. A link command stuck earlier. Still running: no link commands at all, only a reboot attempt,
# which the gate can veto, and the check stops. Finished: bring the port back up, whichever command it
# was (up on an up link changes nothing), and carry on with a normal check. A refused up leaves the
# flag, so the next check tries again.
if [ -e "$RUN/reset_wedged" ]; then
  if wedge_alive; then
    log "ip link set $NIC $WEDGE_WHAT (pid $WEDGE_PID) is still running; not touching the link"
    try_reboot hang noreset "stuck ip link set $NIC $WEDGE_WHAT"
    exit 0
  fi
  stamp_move || exit 0
  rm -f "$RUN/reset_wedged"
  log "the stuck link command has finished; reset_wedged cleared"
  link_cmd up
  [ $? = 124 ] && exit 0
  wait_for_carrier
  # Hang messages from before the command finished are not a failed reset.
  put "$RUN/last_reset" "$((NOW + SECONDS))"
fi

# 2. Carrier.
# No carrier file: the interface is gone, nothing to act on. A read that ran and failed is an
# interface that is administratively down (the kernel answers EINVAL): treat as down. A read that
# overran or could not run tells us nothing: carrier is unknown, and the gateway check still runs.
if [ ! -e "$SYS/$NIC/carrier" ]; then
  log "no carrier file for $NIC; doing nothing"
  restart_gateway_clock
  exit 0
fi
carrier=unknown
limited_read "$LINK_COMMAND_LIMIT" "$RUN/limited.out" read_carrier
crc=$?
case "$crc" in
  0)
    carrier=down
    [ "$(<"$RUN/limited.out")" = 1 ] && carrier=up
    ;;
  1)
    carrier="admin"
    log "carrier unreadable for $NIC (administratively down)"
    ;;
  124)
    log "carrier read for $NIC did not finish in ${LINK_COMMAND_LIMIT}s; carrier is unknown"
    report "carrier read on $NIC did not finish in ${LINK_COMMAND_LIMIT}s"
    ;;
  *) log "carrier read for $NIC could not run (status $crc); carrier is unknown" ;;
esac

# 3. Hang. Capture status first; --grep would exit 1 on "no match" and hide a real failure.
since=$((NOW - 120))
if [ -n "$prev" ]; then
  since="$prev"
  if lr=$(num "$RUN/last_reset") && [ "$lr" -gt "$since" ]; then since="$lr"; fi
fi
limited_read "$JOURNAL_LIMIT" "$RUN/limited.out" journalctl -k -b 0 --no-pager -o cat --since "@$since"
jrc=$?
journal=""
[ "$jrc" = 0 ] && journal=$(<"$RUN/limited.out")
if [ "$jrc" != 0 ]; then
  log "journalctl failed ($jrc); doing nothing"
  restart_gateway_clock
  exit 0
fi
streak=$(num "$RUN/hang_streak") || streak=0
hang=0
case "$journal" in
  *"$NIC: Detected Hardware Unit Hang"*) hang=1 ;;
esac
if [ "$hang" = 1 ]; then
  streak=$((streak + 1))
  put "$RUN/hang_streak" "$streak"
  : >"$RUN/hang_seen" 2>/dev/null
  log "hardware unit hang on $NIC (consecutive checks: $streak)"
else
  streak=0
  put "$RUN/hang_streak" 0
fi

# 4. Episode.
resets=$(num "$RUN/resets") || resets=0
episode=0
{ [ -e "$RUN/hang_seen" ] || [ "$resets" -gt 0 ]; } && episode=1

# 5. Carrier down, nothing wrong beyond a cable or a switch: not ours to fix.
if { [ "$carrier" = down ] || [ "$carrier" = admin ]; } && [ "$episode" = 0 ] && [ "$hang" = 0 ]; then
  log "carrier is down on $NIC with no hang and no episode; leaving it alone"
  rm -f "$RUN/gateway_lost_since"
  exit 0
fi

# An interface left administratively down inside an episode: bring it back up, then carry on toward a
# reboot as for any carrier-down state. Every up restarts the gate's wait, so one on each check would
# hold off the reboot forever: at most one per RETRY_RESET.
if [ "$carrier" = admin ] && [ "$episode" = 1 ] && [ "$LOG_ONLY" = 0 ] && ! moved_within "$RETRY_RESET"; then
  stamp_move || exit 0
  link_cmd up
  [ $? = 124 ] && exit 0
fi

# 6. Gateway. With carrier down or the interface down the port carries nothing, so nothing to ask.
gateway=lost
if [ "$carrier" = up ] || [ "$carrier" = unknown ]; then
  read_route; rc=$?
  if [ "$rc" != 0 ]; then
    log "no default route on vmbr0 (status $rc); doing nothing"
    restart_gateway_clock
    exit 0
  fi
  ping_gateway
  prc=$?
  case "$prc" in
    0) gateway=answers ;;
    1) gateway=lost ;;
    *)
      log "ping ended with status $prc, which is not a lost gateway; doing nothing"
      [ "$prc" = 124 ] && report "ping did not finish in ${PING_LIMIT}s"
      restart_gateway_clock
      exit 0
      ;;
  esac
fi

# 7. Gateway answers: the network is fine, whatever the kernel said. Hang messages move nothing. One
# report line per episode is the evidence of how often the card still hangs.
if [ "$gateway" = answers ]; then
  if [ "$hang" = 1 ] && [ ! -e "$RUN/hang_reported" ]; then
    report "hang messages on $NIC with the gateway answering; port left alone" && : >"$RUN/hang_reported"
  fi
  gateway_answered
  [ "$hang" = 1 ] || clear_episode
  exit 0
fi

# 8. Gateway lost: start the clock.
lost_since=$(num "$RUN/gateway_lost_since") || {
  lost_since="$NOW"
  put "$RUN/gateway_lost_since" "$NOW"
  log "gateway lost"
}

# 9. A hang while the gateway is lost.
if [ "$hang" = 1 ] && [ "$streak" -ge 2 ]; then
  if [ "$resets" -lt 2 ]; then
    do_reset "hang, gateway lost"
  else
    try_reboot hang
  fi
  exit 0
fi

# 10. Gateway-only.
age=$((NOW - lost_since))
[ "$age" -lt 0 ] && age=0
if [ "$resets" -eq 0 ] && [ "$age" -ge "$GATEWAY_RESET_1" ]; then
  do_reset "gateway lost ${age}s"
elif [ "$resets" -eq 1 ] && [ "$age" -ge "$GATEWAY_RESET_2" ]; then
  do_reset "gateway lost ${age}s"
elif [ "$age" -ge "$GATEWAY_REBOOT" ]; then
  try_reboot gateway
else
  log "gateway lost ${age}s; waiting"
fi
exit 0
