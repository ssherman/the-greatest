# Copy this to web-app/.env for local development
# DO NOT commit web-app/.env - it's gitignored

# Rails Configuration
RAILS_ENV=development
RAILS_MASTER_KEY=get_from_config_master_key_or_ask_maintainer

# Database Configuration (local Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=6543
POSTGRES_DATABASE=the_greatest_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password

# Redis Configuration (local Docker)
REDIS_URL=redis://localhost:6379/1

# OpenSearch Configuration (local Docker)
OPENSEARCH_URL=http://localhost:9200

# SSL Certificate Management (not needed for local dev)
# CLOUDFLARE_API_TOKEN=not_needed_locally

# Firebase Authentication (get from Firebase console)
# FIREBASE_PROJECT_ID is not read by the app — it's hardcoded in
# web-app/config/initializers/firebase.rb. Do not set it here.
FIREBASE_API_KEY=your_firebase_api_key

# Base64-encoded JSON key for a GCP service account with firebaseauth.users.get,
# used to look up the email Firebase keeps on a provider record but omits from
# the ID token (see docs/features/oauth-providers.md). Unlike FIREBASE_API_KEY
# this is a real credential, not safe to expose client-side — managed via SOPS,
# never committed. See deployment/ENV.md and deployment/SECRETS.md.
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_encoded_service_account_json

# Performance Tuning (optional)
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
SIDEKIQ_CONCURRENCY=5

# S3 bucket holding production DB backups (used by bin/refresh-dev-db.sh)
BACKUP_BUCKET=your-backup-bucket

# Legacy (old TheGreatestBooks) Cloudflare R2 — used ONLY by the one-time
# `data_migration:book_images` task to read old book cover originals via the S3 API.
# Values come from the old site's Rails credentials (:cloudflare). Not needed for normal runtime.
LEGACY_R2_ACCOUNT_ID=
LEGACY_R2_ACCESS_KEY=
LEGACY_R2_SECRET_KEY=
LEGACY_R2_BUCKET=

# Stripe billing. Use a Sandbox key in development; see docs/specs/membership-and-stripe-billing.md
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVEMODE=false
