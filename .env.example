# Copy this to web-app/.env for local development
# DO NOT commit web-app/.env - it's gitignored

# Rails Configuration
RAILS_ENV=development
RAILS_MASTER_KEY=get_from_config_master_key_or_ask_maintainer

# Database Configuration (local Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=6543
POSTGRES_DATABASE=the_greatest_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password
# Production only; leave unset locally (docs/features/postgres-server.md). The legacy_books connection
# has its own variable and does not fall back to POSTGRES_SSLMODE.
# POSTGRES_SSLMODE=require
# LEGACY_BOOKS_SSLMODE=require

# Redis Configuration (local Docker)
REDIS_URL=redis://localhost:6379/1

# OpenSearch Configuration (local Docker)
OPENSEARCH_URL=http://localhost:9200
# Production only: the search server's certificate is self-made (docs/features/opensearch-server.md)
# OPENSEARCH_SSL_VERIFY=false

# Open Library data service (data-sources/). Backend only -- never on a public
# request path. Production reaches it through a Cloudflare Tunnel on the home
# server (docs/features/home-server.md); development runs it locally.
OPEN_LIBRARY_SERVICE_URL=http://127.0.0.1:8080

# Page fetcher service (data-sources/, docs/features/page-fetcher-service.md).
# Same posture and the same home server as the Open Library service above.
PAGE_FETCHER_SERVICE_URL=http://127.0.0.1:8081

# WorldCat lookup service (data-sources/, docs/features/worldcat-data-service.md).
# Same posture and the same home server as the two services above.
WORLDCAT_SERVICE_URL=http://127.0.0.1:8082

# Cloudflare Access service token for all three services above, in production only.
# Both or neither: one alone fails when any client is first used. Leave blank
# in development.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Contact in the User-Agent sent to Wikidata and Wikipedia (their policy asks
# for one). A URL is enough; defaults to https://thegreatestbooks.org.
# WIKIMEDIA_CONTACT=https://thegreatestbooks.org

# SSL Certificate Management (not needed for local dev)
# CLOUDFLARE_API_TOKEN=not_needed_locally

# Firebase Authentication (get from Firebase console)
# FIREBASE_PROJECT_ID is not read by the app — it's hardcoded in
# web-app/config/initializers/firebase.rb. Do not set it here.
FIREBASE_API_KEY=your_firebase_api_key

# Base64-encoded JSON key for a GCP service account with firebaseauth.users.get,
# used to look up the email Firebase keeps on a provider record but omits from
# the ID token (see docs/features/oauth-providers.md). Unlike FIREBASE_API_KEY
# this is a real credential, not safe to expose client-side — managed via SOPS,
# never committed. See deployment/ENV.md and deployment/SECRETS.md.
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_encoded_service_account_json

# Performance Tuning (optional)
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
SIDEKIQ_CONCURRENCY=5
# Sidekiq dashboard (/sidekiq-admin) Basic auth. Blank = dashboard locked.
SIDEKIQ_ADMIN_USERNAME=
SIDEKIQ_ADMIN_PASSWORD=

# Bucket holding production DB dumps (used by bin/refresh-dev-db.sh). The BACKUP_* settings go in the
# root .env (the project root, not web-app/.env), which is the file refresh-dev-db.sh reads. Until the Postgres move's
# cutover this is the old S3 bucket and the two settings below stay unset. After it, dev reads the R2
# dumps bucket: set BACKUP_BUCKET to it, BACKUP_ENDPOINT to https://<account id>.r2.cloudflarestorage.com,
# and BACKUP_AWS_PROFILE to an aws CLI profile holding the read-only dumps token with region auto
# (docs/features/postgres-server.md, "Dev refresh from R2").
BACKUP_BUCKET=your-backup-bucket
# BACKUP_ENDPOINT=
# BACKUP_AWS_PROFILE=

# Legacy (old TheGreatestBooks) Cloudflare R2 — used ONLY by the one-time
# `data_migration:book_images` task to read old book cover originals via the S3 API.
# Values come from the old site's Rails credentials (:cloudflare). Not needed for normal runtime.
LEGACY_R2_ACCOUNT_ID=
LEGACY_R2_ACCESS_KEY=
LEGACY_R2_SECRET_KEY=
LEGACY_R2_BUCKET=

# Collaborative-filtering recommendations store (private R2 bucket; docs/features/recommendations.md,
# "Collaborative signal"). Leave all three blank in development: the cron jobs skip, and the local loop
# uses a directory (`bin/rails recommendations:export DIR=tmp/recommendations`). The endpoint defaults
# to STORAGE_ENDPOINT; set RECOMMENDATIONS_R2_ENDPOINT only for a different R2 account.
RECOMMENDATIONS_R2_ACCESS_KEY=
RECOMMENDATIONS_R2_SECRET_KEY=
RECOMMENDATIONS_R2_BUCKET=

# Stripe billing. Use a Sandbox key in development; see docs/specs/membership-and-stripe-billing.md
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVEMODE=false
