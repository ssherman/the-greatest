<%= helpers.form_with model: category, url: form_url, class: "space-y-6" do |f| %>
  <!-- Error Messages -->
  <% if category.errors.any? %>
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <h3 class="font-bold"><%= helpers.pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h3>
        <ul class="list-disc list-inside mt-2">
          <% category.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">Basic Information</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Name -->
        <div class="md:col-span-2">
          <%= f.label :name, class: "label" do %>
            <span class="font-semibold">Name <span class="text-error">*</span></span>
          <% end %>
          <%= f.text_field :name,
              class: "input w-full #{category.errors[:name].any? ? 'input-error' : ''}",
              placeholder: "Enter category name",
              required: true,
              autofocus: true %>
          <% if category.errors[:name].any? %>
            <label class="label">
              <span class="text-error"><%= category.errors[:name].first %></span>
            </label>
          <% end %>
        </div>

        <!-- Category Type -->
        <div>
          <%= f.label :category_type, class: "label" do %>
            <span class="font-semibold">Category Type <span class="text-error">*</span></span>
          <% end %>
          <%= f.select :category_type,
              Category.category_types.keys.map { |t| [t.titleize, t] },
              { include_blank: "Select type..." },
              class: "select w-full #{category.errors[:category_type].any? ? 'select-error' : ''}",
              required: true %>
          <% if category.errors[:category_type].any? %>
            <label class="label">
              <span class="text-error"><%= category.errors[:category_type].first %></span>
            </label>
          <% end %>
        </div>

        <!-- Parent Category -->
        <div>
          <%# The label targets the visible search box, not the hidden parent_id
              field AutocompleteComponent names after `id`; the box's id is that
              plus "_autocomplete". Without `for:` the label would point at the
              hidden input and the box would have no accessible name. %>
          <%= f.label :parent_id, class: "label", for: "#{f.object_name}_parent_id_autocomplete" do %>
            <span class="font-semibold">Parent Category</span>
          <% end %>
          <%= render AutocompleteComponent.new(
                name: "#{f.object_name}[parent_id]",
                id: "#{f.object_name}_parent_id",
                url: parent_search_url,
                value: category.parent_id,
                selected_text: parent_selected_text,
                placeholder: "Search for a parent category..."
              ) %>
          <label class="label">
            <span>Optional: pick a parent to make this a subcategory. Leave empty for a top-level category.</span>
          </label>
        </div>

        <!-- Description -->
        <div class="md:col-span-2">
          <%= f.label :description, class: "label" do %>
            <span class="font-semibold">Description</span>
          <% end %>
          <%= f.text_area :description,
              class: "textarea w-full h-32 #{category.errors[:description].any? ? 'textarea-error' : ''}",
              placeholder: "Enter a description for this category..." %>
          <% if category.errors[:description].any? %>
            <label class="label">
              <span class="text-error"><%= category.errors[:description].first %></span>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="flex flex-col sm:flex-row gap-2 justify-end">
    <%= link_to "Cancel", cancel_path, class: "btn btn-ghost" %>
    <%= f.submit submit_label, class: "btn btn-primary" %>
  </div>
<% end %>
