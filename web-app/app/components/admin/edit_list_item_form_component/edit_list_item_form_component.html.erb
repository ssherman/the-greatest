<%= helpers.turbo_frame_tag Admin::EditListItemModalComponent::FRAME_ID do %>
  <h3 class="font-bold text-lg">Edit List Item</h3>
  <%= form_with model: @list_item,
                url: admin_list_item_path(@list_item),
                method: :patch,
                class: "space-y-4",
                data: {
                  controller: "modal-form",
                  modal_form_modal_id_value: Admin::EditListItemModalComponent::DIALOG_ID,
                  turbo_frame: "list_items_list"
                } do |f| %>

    <% if autocomplete_url.present? %>
      <div>
        <%= f.label :item_name, "Current: #{item_display_name}", class: "label" %>
        <%= render AutocompleteComponent.new(
          name: "list_item[listable_id]",
          url: autocomplete_url,
          placeholder: "Search for #{item_label.downcase}...",
          display_key: "text",
          value_key: "value"
        ) %>
      </div>
    <% else %>
      <div>
        <%= f.label :item_name, "Item", class: "label" %>
        <div class="input w-full bg-base-200">
          <%= item_display_name %>
        </div>
        <label class="label">
          <span>Item cannot be changed</span>
        </label>
      </div>
    <% end %>

    <div>
      <%= f.label :position, "Position", class: "label" %>
      <%= f.number_field :position,
          min: 1,
          step: 1,
          value: @list_item.position,
          class: "input w-full",
          required: true %>
      <label class="label">
        <span>Position in the list (must be > 0)</span>
      </label>
    </div>

    <div>
      <%= f.label :metadata, "Metadata (JSON, optional)", class: "label" %>
      <%= f.text_area :metadata,
          rows: 3,
          value: metadata_json,
          placeholder: '{"custom_field": "value"}',
          class: "textarea w-full" %>
      <label class="label">
        <span>Optional JSON metadata</span>
      </label>
    </div>

    <div>
      <label class="label cursor-pointer justify-start gap-2">
        <%= f.check_box :verified, checked: @list_item.verified, class: "checkbox" %>
        <span>Mark as verified</span>
      </label>
    </div>

    <div class="modal-action">
      <button type="button" class="btn" onclick="<%= Admin::EditListItemModalComponent::DIALOG_ID %>.close()">Cancel</button>
      <%= f.submit "Update Item", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
