<div class="<%= container_classes %>"
     data-controller="authentication"
     data-authentication-reload-after-auth-value="<%= reload_after_auth_data %>"
     data-authentication-firebase-src-value="<%= asset_path("firebase-auth.js") %>"
     data-authentication-providers-value="<%= oauth_providers_json %>"
     data-reload-after-auth="<%= reload_after_auth_data %>">

  <!-- Error Message -->
  <div data-authentication-target="errorMessage"
       class="hidden mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded-lg">
  </div>

  <!-- Info Message -->
  <div data-authentication-target="infoMessage"
       class="hidden mb-4 p-3 bg-blue-50 border border-blue-300 text-blue-800 rounded-lg">
  </div>

  <!-- Loading Indicator -->
  <div data-authentication-target="loading"
       class="hidden mb-4 p-3 bg-blue-100 border border-blue-400 text-blue-700 rounded-lg text-center">
    <div class="flex items-center justify-center">
      <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-700 mr-2"></div>
      Authenticating...
    </div>
  </div>

  <!-- Sign In Buttons (hidden when authenticated) -->
  <div data-authentication-target="signInButton">
    <!-- Step 1: Email Entry -->
    <div data-authentication-target="emailStep">
      <!-- OAuth providers, from config/auth_providers.json -->
      <% oauth_providers.each do |provider| %>
        <div class="mb-3">
          <button data-action="click->authentication#signInWithOauth"
                  data-authentication-provider-param="<%= provider[:id] %>"
                  class="btn btn-outline btn-primary w-full flex items-center justify-center gap-2">
            <%= render "shared/auth_icons/#{provider[:id]}" %>
            Sign in with <%= provider[:label] %>
          </button>
        </div>
      <% end %>

      <!-- Divider -->
      <div class="divider text-sm">or</div>

      <!-- Email + Continue -->
      <form data-action="submit->authentication#continueWithEmail">
        <div class="mb-3">
          <input type="email"
                 placeholder="Email address"
                 class="input w-full"
                 data-authentication-target="emailInput"
                 required>
        </div>
        <button type="submit" class="btn btn-primary w-full">
          Continue
        </button>
      </form>
    </div>

    <!-- Step 2: Password Entry -->
    <div data-authentication-target="passwordStep" class="hidden">
      <!-- Email display with change link -->
      <div class="flex items-center justify-between mb-4 px-1">
        <span class="text-sm text-gray-500" data-authentication-target="emailDisplay"></span>
        <a href="#" class="link link-primary text-sm"
           data-action="click->authentication#changeEmail">
          Change
        </a>
      </div>

      <form data-action="submit->authentication#submitEmailForm">
        <div class="mb-3">
          <input type="password"
                 placeholder="Password"
                 class="input w-full"
                 data-authentication-target="passwordInput"
                 minlength="6"
                 required>
        </div>

        <button type="submit" class="btn btn-primary w-full mb-3"
                data-authentication-target="submitButton">
          Sign In
        </button>

        <div class="flex justify-between items-center text-sm">
          <a href="#" class="link link-primary"
             data-action="click->authentication#showForgotPassword">
            Forgot password?
          </a>
          <a href="#" class="link link-primary"
             data-authentication-target="authModeToggle"
             data-action="click->authentication#toggleAuthMode">
            Create account
          </a>
        </div>
      </form>
    </div>

    <!-- Forgot Password Form -->
    <div data-authentication-target="forgotPasswordForm" class="hidden">
      <form data-action="submit->authentication#submitForgotPassword">
        <p class="text-sm text-gray-600 mb-3">Enter your email and we'll send you a reset link.</p>
        <div class="mb-3">
          <input type="email"
                 placeholder="Email address"
                 class="input w-full"
                 data-authentication-target="resetEmailInput"
                 required>
        </div>
        <button type="submit" class="btn btn-primary w-full mb-3">
          Send Reset Link
        </button>
        <div class="text-center">
          <a href="#" class="link link-primary text-sm"
             data-action="click->authentication#backToSignIn">
            Back to Sign In
          </a>
        </div>
      </form>
    </div>

    <!-- Resend Verification -->
    <div data-authentication-target="verificationMessage" class="hidden mt-3 text-center">
      <a href="#" class="link link-primary text-sm"
         data-action="click->authentication#resendVerification">
        Resend verification email
      </a>
    </div>
  </div>

  <!-- User Info (for modal context) -->
  <div data-authentication-target="userInfo" class="hidden">
    <div class="text-center p-4">
      <div class="flex items-center justify-center mb-4">
        <!-- User info will be inserted here by JavaScript -->
      </div>
      <p class="text-sm text-gray-600">Successfully signed in!</p>
    </div>
  </div>
</div>
