<div class="space-y-2">
  <div class="flex items-baseline justify-between gap-4">
    <span class="font-medium"><%= count %> of <%= target_count %> books</span>
    <span class="text-sm font-semibold"><%= percentage_text %>%</span>
  </div>
  <progress class="progress w-full" max="100" value="<%= bar_value %>"
            aria-label="<%= progress_label %>"></progress>
</div>
