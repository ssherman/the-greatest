<article class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="card-body gap-4">
    <div class="flex items-start justify-between gap-4">
      <h2 class="card-title text-xl">
        <%= link_to goal.name, books_reading_goal_path(goal), class: "hover:text-primary" %>
      </h2>
      <span class="badge <%= goal.public? ? 'badge-success' : 'badge-ghost' %>">
        <%= goal.public? ? "Public" : "Private" %>
      </span>
    </div>

    <p class="text-sm text-base-content/70"><%= date_range %></p>

    <%= render Books::ReadingGoals::ProgressComponent.new(
          count: progress.count,
          target_count: goal.target_count,
          percentage: progress.percentage,
          bar_percentage: progress.bar_percentage
        ) %>

    <div class="card-actions items-center gap-2">
      <%= link_to "View", books_reading_goal_path(goal), class: "btn btn-sm" %>
      <%= link_to "Edit", edit_books_my_reading_goal_path(goal), class: "btn btn-sm" %>
      <%= button_to "Delete", books_my_reading_goal_path(goal), method: :delete,
            class: "btn btn-ghost btn-sm text-error",
            form: {
              class: "inline",
              data: {turbo_confirm: "Delete this reading goal? This cannot be undone."}
            } %>

      <% if goal.public? %>
        <div data-controller="clipboard-copy">
          <label class="sr-only" for="reading-goal-share-url-<%= goal.id %>">Share link</label>
          <%= text_field_tag nil, books_reading_goal_url(goal),
                id: "reading-goal-share-url-#{goal.id}",
                readonly: true,
                tabindex: -1,
                class: "sr-only",
                data: {"clipboard-copy-target": "source"} %>
          <button type="button" class="btn btn-primary btn-sm"
                  data-action="clipboard-copy#copy"
                  data-clipboard-copy-target="button">Copy Share Link</button>
        </div>
      <% end %>
    </div>
  </div>
</article>
