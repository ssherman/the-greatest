<div class="space-y-4">
  <% if show_types %>
    <%# Page links, not ARIA tabs: there are no panels, so no role=tablist. The
        active tab is told apart by the tabs-border underline and bold weight,
        never by colour alone. %>
    <nav aria-label="Category type">
      <div class="tabs tabs-border justify-center">
        <% type_links.each do |link| %>
          <%= link_to link[:label], link[:path],
                class: "tab #{"tab-active font-semibold" if link[:active]}",
                aria: {current: (link[:active] ? "page" : nil)} %>
        <% end %>
      </div>
    </nav>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <% if search %>
      <%# No submit button: Enter submits. The type rides along so a result list
          ranks the reader's current tab first. GET forms carry no token. %>
      <%= form_with url: helpers.books_categories_search_path, method: :get,
            class: "w-full sm:w-auto sm:min-w-72",
            data: {turbo_frame: RESULTS_FRAME} do %>
        <label class="input input-sm w-full">
          <svg class="h-4 w-4 opacity-60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <span class="sr-only">Search categories</span>
          <%= search_field_tag :q, query, id: "categories_search", placeholder: "Search categories…", autocomplete: "off", maxlength: Books::BrowseQuery::SEARCH_MAX_LENGTH %>
        </label>
        <%= hidden_field_tag :filter, type, id: nil %>
      <% end %>
    <% end %>

    <details class="dropdown dropdown-end ml-auto">
      <summary class="btn btn-sm">
        <span data-testid="sort-label">Sort: <%= SORT_LABELS.fetch(sort) %></span>
        <span data-testid="sort-caret" aria-hidden="true">▾</span>
      </summary>
      <ul class="dropdown-content menu bg-base-100 rounded-box z-10 w-40 p-2 shadow-sm">
        <% sort_links.each do |link| %>
          <li>
            <%= link_to link[:label], link[:path],
                  class: ("font-semibold" if link[:active]),
                  aria: {current: (link[:active] ? "page" : nil)} %>
          </li>
        <% end %>
      </ul>
    </details>
  </div>
</div>
