<%= helpers.turbo_frame_tag pane_frame_id, data: {"books--filter-target": "pane", axis: axis} do %>
  <%# turbo-frame has no default display, so its inline-flex .label children would
      flow sideways and wrap into columns without this. %>
  <%= helpers.turbo_frame_tag results_frame_id, class: "flex flex-col gap-1",
        data: {"books--filter-target": "results", axis: axis, results_src: results_src} %>

  <div class="flex flex-col gap-1" data-books--filter-target="browse" data-axis="<%= axis %>">
    <%= render Books::FilterOptionRowsComponent.new(axis: axis, rows: facet_rows) %>
  </div>

  <p class="text-sm text-warning hidden" role="status" aria-live="polite" data-books--filter-target="capNotice" data-axis="<%= axis %>"></p>
<% end %>
