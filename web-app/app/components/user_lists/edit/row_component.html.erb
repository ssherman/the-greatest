<div id="<%= dom_id(item) %>"
     class="flex items-center gap-3 rounded-box bg-base-100 p-2 shadow-sm"
     data-position="<%= item.position %>"
     data-item-id="<%= item.id %>"
     tabindex="-1"
     data-page="<%= page %>">
  <span class="badge badge-ghost shrink-0" aria-label="Position <%= item.position %>"><%= item.position %></span>

  <% if cover %>
    <%= image_tag rails_public_blob_url(cover.file), alt: "", loading: "lazy", decoding: "async", class: "h-14 w-10 shrink-0 rounded object-cover" %>
  <% end %>

  <div class="min-w-0 grow">
    <p class="font-bold truncate"><%= title %></p>
    <% if by_line.present? || completed_on_enabled? %>
      <%# Below sm the author and the date sit on their own lines: the column is too narrow to truncate them together. %>
      <p class="text-sm text-base-content/70 sm:truncate">
        <% if by_line.present? %><span class="block truncate sm:inline"><%= by_line %></span><% end %>
        <% if completed_on_enabled? %>
          <span class="block sm:inline"><% if by_line.present? %><span class="hidden sm:inline"> · </span><% end %><%= render UserLists::CompletionDateComponent.new(item: item, variant: :row) %></span>
        <% end %>
      </p>
    <% end %>
  </div>

  <%# The menu's buttons submit these through their form attribute: a form between li and button breaks the daisyUI menu. %>
  <%= form_with url: move_my_list_item_path(user_list, item), method: :patch, id: dom_id(item, :move_top), class: "hidden" do %>
    <%= hidden_field_tag "user_list_item[position]", 1, id: nil %>
    <%= hidden_field_tag :page, page, id: nil %>
  <% end %>
  <%= form_with url: move_my_list_item_path(user_list, item), method: :patch, id: dom_id(item, :move_bottom), class: "hidden" do %>
    <%= hidden_field_tag "user_list_item[position]", item_count, id: nil %>
    <%= hidden_field_tag :page, page, id: nil %>
  <% end %>

  <div class="dropdown dropdown-end shrink-0">
    <button type="button" tabindex="0" class="btn btn-ghost btn-sm" aria-label="Actions for <%= title %>">⋯</button>
    <ul tabindex="0" class="dropdown-content menu z-10 w-60 rounded-box bg-base-100 p-2 shadow" data-row-actions>
      <li>
        <button type="submit" form="<%= dom_id(item, :move_top) %>">
          <%= helpers.icon "arrow-up-to-line", library: "lucide", class: "size-4", aria_hidden: "true" %>Move to top
        </button>
      </li>
      <li>
        <button type="submit" form="<%= dom_id(item, :move_bottom) %>">
          <%= helpers.icon "arrow-down-to-line", library: "lucide", class: "size-4", aria_hidden: "true" %>Move to bottom
        </button>
      </li>
      <li>
        <button type="button"
                data-action="user-list-position#open"
                data-item-id="<%= item.id %>"
                data-item-title="<%= title %>"
                data-position="<%= item.position %>"
                data-max="<%= item_count %>">
          <%= helpers.icon "hash", library: "lucide", class: "size-4", aria_hidden: "true" %>Move to position…
        </button>
      </li>
      <% if completed_on_enabled? %>
        <li role="separator" aria-hidden="true"></li>
        <li>
          <button type="button"
                  data-action="user-list-completion#open"
                  data-variant="row"
                  data-item-id="<%= item.id %>"
                  data-item-title="<%= title %>"
                  data-completed-on="<%= item.completed_on&.iso8601 %>">
            <%= helpers.icon "calendar", library: "lucide", class: "size-4", aria_hidden: "true" %>Set <%= user_list.completion_label.downcase %> date…
          </button>
        </li>
      <% end %>
    </ul>
  </div>

  <%= button_to "✕", my_list_item_path(user_list, item), method: :delete, params: {page: page},
        form_class: "shrink-0", class: "btn btn-ghost btn-sm", aria: {label: "Remove #{title}"} %>

  <span data-sortable-handle aria-hidden="true" class="shrink-0 cursor-grab select-none px-1 text-base-content/40">⠿</span>
</div>
