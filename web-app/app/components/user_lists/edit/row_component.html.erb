<div id="<%= dom_id(item) %>"
     class="flex items-center gap-3 rounded-box bg-base-100 p-2 shadow-sm"
     data-position="<%= item.position %>"
     data-item-id="<%= item.id %>"
     data-page="<%= page %>">
  <span class="badge badge-neutral shrink-0" aria-label="Position <%= item.position %>"><%= item.position %></span>

  <% if cover %>
    <%= image_tag rails_public_blob_url(cover.file), alt: "", loading: "lazy", decoding: "async", class: "h-14 w-10 shrink-0 rounded object-cover" %>
  <% end %>

  <div class="min-w-0 grow">
    <p class="font-bold truncate"><%= title %></p>
    <% if by_line.present? %>
      <p class="text-sm text-base-content/70 truncate"><%= by_line %></p>
    <% end %>
    <% if completed_on_enabled? %>
      <% if item.completed_on %>
        <%= render UserLists::CompletionDateComponent.new(item: item, variant: :text) %>
      <% else %>
        <p id="<%= dom_id(item, :completion) %>" class="text-sm text-base-content/40">No <%= user_list.completion_label.downcase %> date</p>
      <% end %>
    <% end %>
  </div>

  <div class="dropdown dropdown-end shrink-0">
    <button type="button" tabindex="0" class="btn btn-ghost btn-sm" aria-label="Actions for <%= title %>">⋯</button>
    <ul tabindex="0" class="dropdown-content menu z-10 w-48 rounded-box bg-base-100 p-2 shadow" data-row-actions>
      <%# Task 9: row actions (move to top/bottom, set date) go here. %>
    </ul>
  </div>

  <%# Task 9: the ✕ remove button goes here. %>
  <div data-row-remove-slot></div>

  <span data-sortable-handle aria-hidden="true" class="shrink-0 cursor-grab select-none px-1 text-base-content/40">⠿</span>
</div>
