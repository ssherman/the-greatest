<section id="list-details" class="card bg-base-100 shadow-sm mb-6">
  <%= form_with model: user_list, scope: :user_list, url: helpers.my_list_path(user_list), method: :patch, class: "card-body gap-3" do |f| %>
    <div class="flex items-end gap-4">
      <fieldset class="fieldset flex-1">
        <legend class="fieldset-legend">Name</legend>
        <% if user_list.default? %>
          <%= f.text_field :name, disabled: true, class: "input w-full", aria: {label: "Name", describedby: "list-name-locked"} %>
        <% else %>
          <%= f.text_field :name, required: true, maxlength: Services::UserLists::ListRules::NAME_MAX, class: "input w-full", aria: {label: "Name"}, autocomplete: "off" %>
        <% end %>
      </fieldset>

      <label class="label cursor-pointer gap-2 pb-2">
        <%= f.check_box :public, class: "toggle" %>
        <span>Public</span>
      </label>
    </div>
    <% if user_list.default? %>
      <p id="list-name-locked" class="text-sm text-base-content/60">Built-in lists keep their names.</p>
    <% end %>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Description (optional)</legend>
      <%= f.text_area :description, maxlength: Services::UserLists::ListRules::DESCRIPTION_MAX, rows: 3, class: "textarea w-full", aria: {label: "Description (optional)"} %>
    </fieldset>

    <p id="list-details-errors" class="text-error text-sm" role="alert"></p>

    <div class="card-actions items-center justify-between">
      <% if user_list.default? %>
        <span></span>
      <% else %>
        <button type="submit" form="delete-list-form" class="btn btn-ghost text-error">Delete list</button>
      <% end %>
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  <% end %>
</section>
