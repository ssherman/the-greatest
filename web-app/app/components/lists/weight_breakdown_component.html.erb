<div class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">How good is this list?</h2>

    <% if ranked_list.nil? %>
      <p class="text-base-content/70">This list is not used for any active rankings.</p>
    <% elsif details.blank? %>
      <p class="text-base-content/70">Weight calculation details not available.</p>
    <% else %>
      <p class="text-3xl font-semibold">Weight <%= final_weight %>%</p>
      <p class="text-base text-base-content/80"><%= penalty_count_line %></p>

      <% if penalties.any? %>
        <%# A native disclosure, so opening it costs no JavaScript. The heading stays
            out of the summary: some screen readers expose a summary as a button and
            drop any heading inside it. %>
        <details class="collapse collapse-arrow border border-base-300 bg-base-200 mt-2">
          <summary class="collapse-title font-semibold">See how this was worked out</summary>
          <div class="collapse-content">
            <dl class="text-sm divide-y divide-base-300 max-w-2xl">
              <div class="flex justify-between gap-6 py-2 font-semibold">
                <dt class="min-w-0 [overflow-wrap:anywhere]">Base weight</dt>
                <dd class="whitespace-nowrap tabular-nums"><%= base_weight %>%</dd>
              </div>

              <% penalties.each do |penalty| %>
                <div class="flex justify-between gap-6 py-2">
                  <dt class="min-w-0 [overflow-wrap:anywhere]"><%= penalty["penalty_name"] %></dt>
                  <dd class="whitespace-nowrap tabular-nums">−<%= pct(penalty["value"]) %>%</dd>
                </div>
              <% end %>

              <div class="flex justify-between gap-6 py-2 font-semibold">
                <dt class="min-w-0 [overflow-wrap:anywhere]">Total penalty</dt>
                <dd class="whitespace-nowrap tabular-nums">−<%= total_penalty %>%</dd>
              </div>

              <% if quality_bonus %>
                <div class="flex justify-between gap-6 py-2 text-success">
                  <dt class="min-w-0 [overflow-wrap:anywhere]">High quality source bonus</dt>
                  <dd class="whitespace-nowrap tabular-nums">+<%= quality_bonus %>%</dd>
                </div>
              <% end %>

              <% if capped_penalty %>
                <div class="flex justify-between gap-6 py-2">
                  <dt class="min-w-0 [overflow-wrap:anywhere]">Penalty capped at</dt>
                  <dd class="whitespace-nowrap tabular-nums">−<%= capped_penalty %>%</dd>
                </div>
              <% end %>

              <% if floored_weight %>
                <div class="flex justify-between gap-6 py-2">
                  <dt class="min-w-0 [overflow-wrap:anywhere]">Raised to the minimum weight</dt>
                  <dd class="whitespace-nowrap tabular-nums"><%= floored_weight %>%</dd>
                </div>
              <% end %>

              <div class="flex justify-between gap-6 py-2 font-semibold">
                <dt class="min-w-0 [overflow-wrap:anywhere]">Final weight</dt>
                <dd class="whitespace-nowrap tabular-nums"><%= final_weight %>%</dd>
              </div>
            </dl>
          </div>
        </details>
      <% end %>
    <% end %>
  </div>
</div>
