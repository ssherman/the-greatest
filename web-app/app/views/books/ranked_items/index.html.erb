<%
  content_for :page_title, "#{@page_title} | The Greatest Books"
  content_for :meta_description, "#{@page_title}. Aggregated from hundreds of published best-books lists from critics, authors, and readers."
  content_for :canonical_url, request.base_url + @canonical_path if @canonical_path
%>

<div class="space-y-8">
  <h1 class="text-3xl sm:text-4xl font-bold text-center text-balance"><%= @page_title %></h1>

  <% if @show_hero %>
    <div class="bg-base-100 border border-base-300 rounded-xl p-6 md:p-10">
      <div class="max-w-3xl mx-auto">
        <p class="text-base sm:text-lg leading-relaxed text-base-content/80">
          What makes a book one of the greatest ever written? The Greatest Books aggregates hundreds of
          published "best books" lists from critics, authors, and readers, then weighs each list by its
          quality, credibility, and scope to produce a single consensus ranking.
        </p>
      </div>
    </div>
  <% end %>

  <%= render Books::FilterBarComponent.new(
        categories: @categories,
        countries: @countries,
        year_start: @year_start,
        year_end: @year_end,
        ranking_configuration: @ranking_configuration,
        collection: @collection
      ) %>

  <% if @ranked_books.any? %>
    <div class="<%= Books::CardComponent::GRID_CONTAINER_CLASS %>">
      <% @ranked_books.each_with_index do |ranked_item, index| %>
        <%= render Books::CardComponent.new(book: ranked_item.item, rank: ranked_item.rank, index: index) %>
      <% end %>
    </div>

    <div class="flex justify-center">
      <%== @pagy.series_nav(slots: 5) %>
    </div>
    <p class="text-center text-sm text-base-content/70">
      Page <%= number_with_delimiter(@pagy.page) %> of <%= number_with_delimiter(@pagy.last) %>
    </p>
  <% else %>
    <div class="text-center py-16">
      <div class="text-6xl mb-4">📚</div>
      <h2 class="text-2xl font-bold mb-2">No books found</h2>
      <p class="text-base-content/70">
        <% if @filtered %>
          No ranked books match these filters. Try removing one.
        <% else %>
          No books have been ranked in this configuration yet.
        <% end %>
      </p>
    </div>
  <% end %>
</div>

<%= render Books::FilterModalComponent.new(
      categories: @categories,
      countries: @countries,
      year_start: @year_start,
      year_end: @year_end,
      ranking_configuration: @ranking_configuration,
      collection: @collection
    ) %>
