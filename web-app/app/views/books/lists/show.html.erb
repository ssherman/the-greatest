<%
  content_for :page_title, truncate("#{@list.name}#{" from #{@list.source}" if @list.source.present?} | The Greatest Books", length: 70)
  content_for :meta_description, truncate("All #{@pagy.count} books on “#{@list.name}”#{", from #{@list.source}" if @list.source.present?}. #{@list.description}", length: 160)

  facts = [
    ("Source: #{@list.source}" if @list.source.present?),
    (@list.yearly_award? ? "Yearly Award" : @list.year_published if @list.year_published.present?),
    pluralize(@pagy.count, "book"),
    (pluralize(number_with_delimiter(@list.number_of_voters), "voter") if @list.number_of_voters.present?)
  ].compact

  panel_class = "card bg-base-100 border border-base-300 shadow-sm"
  prose_class = "max-w-[68ch] text-base leading-relaxed text-base-content/80 whitespace-pre-line [overflow-wrap:anywhere]"
%>

<div class="space-y-8">
  <div class="grid gap-6 lg:grid-cols-3 items-start">
    <div class="min-w-0 space-y-6 lg:col-span-2">
      <div class="<%= panel_class %>">
        <div class="card-body gap-4 text-base">
          <h1 class="text-3xl sm:text-4xl font-bold text-balance [overflow-wrap:anywhere]"><%= @list.name %></h1>

          <ul class="flex flex-wrap gap-2">
            <% facts.each do |fact| %>
              <%# One inline child inside the badge: the badge is inline-flex, so the
                  text can only wrap inside its own element. %>
              <li class="badge badge-lg h-auto py-1 max-w-full bg-base-200 border-base-300">
                <span class="min-w-0 whitespace-normal [overflow-wrap:anywhere]"><%= fact %></span>
              </li>
            <% end %>
          </ul>

          <% if @list.description.present? %>
            <p class="<%= prose_class %>"><%= @list.description %></p>
          <% end %>

          <% if @list.url.present? %>
            <div class="card-actions">
              <%= link_to "View the original list", @list.url, rel: "noopener nofollow",
                    target: "_blank", class: "btn btn-sm btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @list.voter_details.present? %>
        <section class="<%= panel_class %>" data-testid="list-voter-details">
          <div class="card-body">
            <h2 class="card-title">Who voted</h2>
            <% if @list.voter_details.length > 600 %>
              <details class="collapse collapse-arrow border border-base-300 bg-base-200 mt-2">
                <summary class="collapse-title font-semibold">Show voters and how they were chosen</summary>
                <div class="collapse-content">
                  <p class="<%= prose_class %>"><%= @list.voter_details %></p>
                </div>
              </details>
            <% else %>
              <p class="<%= prose_class %>"><%= @list.voter_details %></p>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <div class="min-w-0">
      <%= render Lists::WeightBreakdownComponent.new(ranked_list: @ranked_list) %>
    </div>
  </div>

  <% if @list_items.any? %>
    <div class="<%= Books::CardComponent::GRID_CONTAINER_CLASS %>">
      <% @list_items.each_with_index do |list_item, index| %>
        <% book = list_item.listable %>
        <% next unless book %>
        <%= render Books::CardComponent.new(book: book, rank: list_item.position, index: index, ranking_configuration: @ranking_configuration) %>
      <% end %>
    </div>

    <div class="flex justify-center">
      <%== @pagy.series_nav(slots: 5) %>
    </div>
    <p class="text-center text-sm text-base-content/70">
      Page <%= number_with_delimiter(@pagy.page) %> of <%= number_with_delimiter(@pagy.last) %>
    </p>
  <% else %>
    <div class="text-center py-16">
      <%= image_tag "/icons/books/logo.svg", width: 64, height: 64, alt: "", class: "mx-auto mb-4" %>
      <h2 class="text-2xl font-bold mb-2">No books on this list yet</h2>
    </div>
  <% end %>
</div>
