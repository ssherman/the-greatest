<%
  content_for :page_title, "#{@page_title} | The Greatest Books"
  content_for :meta_description, "Search book genres, subjects and settings."
%>

<div class="space-y-8">
  <h1 class="text-3xl sm:text-4xl font-bold text-center text-balance"><%= @page_title %></h1>

  <%= render Books::BrowseToolbarComponent.new(
        axis: :categories, type: @type, sort: Books::BrowseQuery.normalized_sort(nil),
        show_types: false, search: true, query: @query
      ) %>

  <%# Same frame id as the grid page, so Turbo can lift this frame out of a
      full-page search response and swap it in place. %>
  <%= turbo_frame_tag Books::BrowseToolbarComponent::RESULTS_FRAME, target: "_top", class: "block space-y-8" do %>
    <p class="text-center text-base-content/70" aria-live="polite">
      <% if @query.strip.length < Books::BrowseQuery::SEARCH_MIN_LENGTH %>
        Type at least <%= Books::BrowseQuery::SEARCH_MIN_LENGTH %> characters to search.
      <% elsif @records.any? %>
        <%= pluralize(@records.size, "category") %> <%= (@records.size == 1) ? "matches" : "match" %> “<%= @query.strip.first(Books::BrowseQuery::SEARCH_MAX_LENGTH) %>”
      <% else %>
        No categories match “<%= @query.strip.first(Books::BrowseQuery::SEARCH_MAX_LENGTH) %>”.
      <% end %>
    </p>

    <% if @records.any? %>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        <% @records.each do |record| %>
          <%= render Books::BrowseCardComponent.new(
                record: record, count: record.ranked_count, path: Books::FilterPath.call(categories: [record]),
                chain: @chains.fetch(record.id, []), label: record.type_label
              ) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
