<%
  content_for :page_title, "#{@page_title} | The Greatest Books"
  content_for :meta_description, "Search book genres, subjects and settings."
%>

<div class="space-y-8">
  <h1 class="text-3xl sm:text-4xl font-bold text-center text-balance"><%= @page_title %></h1>

  <%= render Books::BrowseToolbarComponent.new(
        axis: :categories, type: @type, active_type: nil, sort: Books::BrowseQuery.normalized_sort(nil),
        show_types: true, show_sort: false, search: true, query: @query,
        browse_path: Books::BrowsePath.call(axis: :categories, type: @type)
      ) %>

  <%# Same frame id as the grid page, so Turbo can lift this frame out of a
      full-page search response and swap it in place. %>
  <%= turbo_frame_tag Books::BrowseToolbarComponent::RESULTS_FRAME, target: "_top", class: "block space-y-8" do %>
    <p class="text-center text-base-content/70" data-search-status>
      <% if @term.length < Books::BrowseQuery::SEARCH_MIN_LENGTH %>
        Type at least <%= Books::BrowseQuery::SEARCH_MIN_LENGTH %> characters to search.
      <% elsif @records.size == Books::BrowseQuery::SEARCH_LIMIT %>
        Showing the top <%= @records.size %> matches for “<%= @term %>”
      <% elsif @records.any? %>
        <%= pluralize(@records.size, "category") %> <%= (@records.size == 1) ? "matches" : "match" %> “<%= @term %>”
      <% else %>
        No categories match “<%= @term %>”.
      <% end %>
    </p>

    <% if @records.any? %>
      <%= render "books/browse/category_grid", records: @records, chains: @chains, show_type: true %>
    <% end %>
  <% end %>
</div>
