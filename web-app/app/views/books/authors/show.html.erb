<%
  content_for :page_title, "The Greatest Books by #{@author.name} | The Greatest Books"
  content_for :meta_description, "The greatest books written by #{@author.name}, ranked from hundreds of published best-books lists."
%>

<div class="space-y-8">
  <div class="card bg-base-100 shadow-md">
    <div class="card-body">
      <div class="flex flex-col sm:flex-row gap-6">
        <div class="w-40 sm:w-48 shrink-0 mx-auto sm:mx-0">
          <%= render Books::AuthorAvatarComponent.new(author: @author, size_classes: "w-full aspect-square") %>
        </div>

        <div class="min-w-0 space-y-4">
          <div class="space-y-2">
            <h1 class="text-3xl sm:text-4xl font-bold text-balance"><%= @author.name %></h1>

            <div class="flex items-center gap-2 flex-wrap">
              <% if @ranked_item %>
                <span class="badge badge-primary">Ranked #<%= @ranked_item.rank %> of The Greatest Authors</span>
                <span class="badge badge-ghost">
                  <span class="sr-only">Score </span><%= number_with_delimiter(@ranked_item.score.round(1)) %>
                </span>
              <% end %>
              <% if @author.birth_year %>
                <span class="text-sm text-base-content/70">
                  <%= @author.birth_year %><%= "–#{@author.death_year}" if @author.death_year %>
                </span>
              <% end %>
            </div>
          </div>

          <% if @description %>
            <div>
              <div class="text-base-content/80 leading-relaxed space-y-4">
                <%= simple_format(@description.content, {}, wrapper_tag: "p") %>
              </div>
              <% if @description.license_cc_by_sa_4? || @description.license_cc0? %>
                <p class="text-xs text-base-content/70 mt-3">
                  Source:
                  <% source_label = @description.source_name.presence || @description.source.titleize %>
                  <% if @description.source_url.present? %>
                    <%= link_to source_label, @description.source_url, class: "link", rel: "noopener nofollow", target: "_blank" %>
                  <% else %>
                    <%= source_label %>
                  <% end %>
                  · <%= @description.license_cc_by_sa_4? ? "CC BY-SA 4.0" : "CC0" %>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-4">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <h2 class="text-2xl font-bold">Ranked books</h2>
      <%= link_to "All books", author_all_books_path(@author.slug), class: "btn btn-sm btn-outline" %>
    </div>

    <p class="text-sm text-base-content/70">
      These are only the books that appear on the lists aggregated by this site. It is not a
      complete bibliography.
    </p>

    <% if @ranked_books.any? %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 sm:gap-6">
        <% @ranked_books.each_with_index do |book, index| %>
          <%= render Books::CardComponent.new(book: book, rank: book.ranked_position, index: index) %>
        <% end %>
      </div>
    <% else %>
      <p class="text-base-content/70">None of this author's books are ranked yet.</p>
    <% end %>
  </div>
</div>
