<%= turbo_frame_tag "books_filter_results_#{type}", class: "flex flex-col gap-1",
      data: {"books--filter-target": "results", type: type} do %>
  <% if rows.any? %>
    <div class="flex flex-col gap-1 pb-2 mb-2 border-b border-base-300">
      <%= render Books::FilterOptionRowsComponent.new(axis: "category", type: type, rows: rows, show_counts: false) %>
    </div>
  <% end %>
<% end %>
