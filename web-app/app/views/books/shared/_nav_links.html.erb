<%# `variant` controls the "Lists" submenu only. :horizontal keeps the floating
    dropdown styling used by the desktop bar; :vertical drops it so the submenu
    expands inline inside the drawer panel, which is what makes this read better
    than the legacy site's floating-menu-over-a-panel. %>
<% variant = local_assigns.fetch(:variant, :horizontal) %>
<li><%= link_to "Books", books_root_path %></li>
<li>
  <details>
    <summary>Lists</summary>
    <%# :vertical (the drawer panel): daisyUI sets white-space: nowrap on
        `.menu :where(li ul)`, and .drawer-side is overflow-x: hidden, so a
        label wider than the 320px (w-80) panel is CLIPPED, not wrapped or
        scrolled. The longest label today, "The Greatest Books of the 21st
        Century", measures 279px -- about one word of headroom. A longer
        collection name added later would be silently cut off with no test
        failure and no build error. %>
    <ul class="<%= "bg-base-100 rounded-box z-[1] w-max max-w-[calc(100vw-2rem)] p-2 shadow" if variant == :horizontal %>">
      <li><%= link_to "All Lists", books_lists_path %></li>
      <li class="menu-title"><span class="sr-only">Curated collections</span></li>
      <li><%= link_to "The Global Canon", books_global_canon_path %></li>
      <li><%= link_to "The Greatest Books of the 21st Century", "/the-greatest-books/since/2000" %></li>
      <%# Legacy menu order (women, africa, asia, latin-america, non-western, western) --
          NOT the registry's order. See Books::CollectionsRegistry / Collections::Registry
          for behaviour; this list is presentation order only. %>
      <li><%= link_to "Greatest Books Written by Women", "/women" %></li>
      <li><%= link_to "Greatest African Books", "/africa" %></li>
      <li><%= link_to "Greatest Asian Books", "/asia" %></li>
      <li><%= link_to "Greatest Latin American Books", "/latin-america" %></li>
      <li><%= link_to "Greatest Non-Western Canon Books", "/non-western" %></li>
      <li><%= link_to "Greatest Western Canon Books", "/western" %></li>
      <li><%= link_to "Our Users' Favorite Books of All Time", "/lists/463" %></li>
    </ul>
  </details>
</li>
<li><%= link_to "Authors", books_authors_path %></li>
<li><%= link_to "News", news_path %></li>
<%# Revealed client-side by user_list_state_controller when signed in. Keeping
    the wrapper in cacheable HTML lets both responsive copies hydrate safely. %>
<% if variant == :horizontal %>
  <li id="navbar_my_books" class="hidden">
    <details>
      <summary>My Books</summary>
      <ul class="bg-base-100 rounded-box z-[1] w-max max-w-[calc(100vw-2rem)] p-2 shadow">
        <li><%= link_to "Lists", my_lists_path %></li>
        <li><%= link_to "Reading Goals", books_my_reading_goals_path %></li>
        <li><%= link_to "Reviews", my_reviews_path %></li>
        <li><%= link_to "Saved Searches", saved_searches_path %></li>
      </ul>
    </details>
  </li>
<% else %>
  <li id="navbar_my_books" class="hidden">
    <span class="menu-title">My Books</span>
    <ul>
      <li><%= link_to "Lists", my_lists_path %></li>
      <li><%= link_to "Reading Goals", books_my_reading_goals_path %></li>
      <li><%= link_to "Reviews", my_reviews_path %></li>
      <li><%= link_to "Saved Searches", saved_searches_path %></li>
    </ul>
  </li>
<% end %>
<%# Revealed client-side by membership_state_controller when the visitor is a member. %>
<li id="navbar_members" class="hidden"><a href="/members">Members</a></li>
<li><%= link_to "Support", membership_path %></li>
