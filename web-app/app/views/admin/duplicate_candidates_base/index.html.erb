<%# web-app/app/views/admin/duplicate_candidates_base/index.html.erb %>
<% content_for :title, "Duplicate Candidates" %>
<%# Merge and dismiss redirect back to this exact URL, which Turbo treats as a
    refresh: morph keeps the admin's scroll position as resolved pairs drop out. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-2xl font-bold">Duplicate Candidates</h1>
    <% if @agent_prompt %>
      <div data-controller="clipboard-copy">
        <textarea hidden readonly data-clipboard-copy-target="source"><%= @agent_prompt %></textarea>
        <button type="button" class="btn btn-sm" data-action="clipboard-copy#copy"
                data-clipboard-copy-target="button" data-testid="copy-agent-prompt">Copy prompt</button>
      </div>
    <% end %>
  </div>

  <div role="tablist" class="tabs tabs-border">
    <% Admin::DuplicateCandidatesBaseController::STATUSES.each do |status| %>
      <%= link_to duplicates_index_path(status: status), role: "tab",
            class: "tab #{"tab-active" if @status == status}", data: {testid: "status-tab-#{status}"} do %>
        <%= status.humanize %>
        <span class="badge badge-sm ml-2" data-testid="status-count-<%= status %>"><%= @counts[status].to_i %></span>
      <% end %>
    <% end %>
  </div>

  <% if @status != "pending" %>
    <div class="join" data-testid="via-filter">
      <% [["All", nil], ["Admin page", "admin_ui"], ["API", "api"]].each do |label, via| %>
        <%= link_to label, duplicates_index_path(status: @status, via: via),
              class: "btn btn-xs join-item #{"btn-active" if @via == via}", data: {testid: "via-#{via || "all"}"} %>
      <% end %>
    </div>
  <% end %>

  <% if @pairs.any? %>
    <div class="space-y-4">
      <%= render partial: "admin/duplicate_candidates_base/pair", collection: @pairs, as: :pair %>
    </div>
  <% else %>
    <p class="text-center text-base-content/70 py-8">No <%= @status.humanize.downcase %> pairs.</p>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="mt-4 flex justify-center"><%== @pagy.series_nav %></div>
  <% end %>
</div>
