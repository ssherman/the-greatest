<% content_for :title, "Alternate titles to review" %>

<div class="space-y-4">
  <h1 class="text-2xl font-bold">Alternate titles to review</h1>
  <p class="text-sm text-base-content/70">
    Titles the AI review could not settle, oldest first. Keep one to list it on the book, or remove it.
  </p>

  <%= form_with url: review_admin_books_alternate_titles_path, method: :get, class: "flex flex-wrap items-end gap-3", data: {testid: "alternate-title-filters"} do |form| %>
    <div>
      <%= form.label :source, "Source", class: "label text-xs" %>
      <%= form.select :source, options_for_select([["All", ""]] + Admin::Books::AlternateTitlesController::SOURCES.map { |value| [value.humanize, value] }, params[:source]), {}, class: "select select-sm" %>
    </div>
    <%= form.submit "Filter", class: "btn btn-sm" %>
    <%= link_to "Reset", review_admin_books_alternate_titles_path, class: "btn btn-sm btn-ghost" %>
  <% end %>

  <% if @rows.empty? %>
    <p class="text-base-content/60">Nothing to review.</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="table bg-base-100">
        <thead>
          <tr>
            <th>Book</th><th>Title</th><th>Source</th><th>Status</th><th>Verdict</th><th>Category</th>
            <th>Confidence</th><th>Reason</th><th>AI chat</th><th>Decided</th><th></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "admin/books/alternate_titles/row", collection: @rows, as: :row, locals: {show_book: true} %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %>
      <div class="flex justify-center"><%== @pagy.series_nav %></div>
    <% end %>
  <% end %>
</div>
