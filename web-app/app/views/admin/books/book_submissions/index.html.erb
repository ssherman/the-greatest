<% content_for :title, "Book Submissions" %>

<div class="space-y-6">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold">Book Submissions</h1>
      <p class="text-base-content/70">Books readers asked for that the site lacked. Approve makes the book public; merge and reject are permanent.</p>
    </div>
    <div data-controller="clipboard-copy">
      <textarea hidden readonly data-clipboard-copy-target="source"><%= @agent_prompt %></textarea>
      <button type="button" class="btn btn-sm" data-action="clipboard-copy#copy"
              data-clipboard-copy-target="button" data-testid="copy-agent-prompt">Copy prompt</button>
    </div>
  </div>

  <div role="tablist" class="tabs tabs-border flex-wrap" data-testid="submission-tabs">
    <% ::Services::Books::BookSubmissions::QueueTabs::LABELS.each do |key, label| %>
      <%= link_to admin_books_book_submissions_path(tab: key), role: "tab", class: ["tab", ("tab-active" if key == @tab)],
            data: {testid: "tab-#{key.dasherize}"}, aria: {selected: key == @tab} do %>
        <%= label %> <span class="badge badge-sm badge-ghost ml-2" data-testid="count-<%= key.dasherize %>"><%= number_with_delimiter(@counts[key]) %></span>
      <% end %>
    <% end %>
  </div>

  <% one_submission = @preview_only || @single_view %>
  <% if one_submission && @submissions.any? %>
    <div class="alert alert-info" data-testid="single-submission">
      <span><%= @preview_only ? "Showing the submission you are previewing. Nothing has changed yet." : "Showing the one submission, as it is now." %></span>
      <%= link_to "Back to the queue", queue_path, class: "btn btn-sm btn-ghost", data: {testid: "back-to-queue"} %>
    </div>
  <% elsif @book_id && !one_submission %>
    <div class="alert alert-info" data-testid="book-filter">
      <span>Showing the submissions for book
        <% if ::Books::Book.exists?(@book_id) %><%= link_to "##{@book_id}", admin_books_book_path(@book_id), class: "link" %><% else %>#<%= @book_id %> (deleted)<% end %>
        only.</span>
      <%= link_to "Show all", admin_books_book_submissions_path(tab: @tab), class: "btn btn-sm btn-ghost" %>
    </div>
  <% end %>

  <% if @submissions.any? %>
    <div class="space-y-4">
      <%= render partial: "admin/books/book_submissions/submission", collection: @submissions, as: :submission %>
    </div>
    <% if @pagy && @pagy.pages > 1 %>
      <div class="flex justify-center"><%== @pagy.series_nav %></div>
    <% end %>
  <% else %>
    <p class="text-base-content/70" data-testid="no-submissions">Nothing here.</p>
    <% if one_submission %><%= link_to "Back to the queue", queue_path, class: "btn btn-sm btn-ghost", data: {testid: "back-to-queue"} %><% end %>
  <% end %>
</div>
