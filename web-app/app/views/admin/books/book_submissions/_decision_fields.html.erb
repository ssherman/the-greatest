<%# Locals: tab, rows, and optionally note and sources to prefill. The note and sources every decision carries; the id suffix keeps the ids unique per row. %>
<%= render "admin/books/book_submissions/return_fields" %>
<fieldset class="fieldset">
  <legend class="fieldset-legend">Note: the evidence</legend>
  <%= text_area_tag :note, local_assigns[:note], class: "textarea w-full", rows: rows, required: true, maxlength: 1000, id: nil %>
</fieldset>
<fieldset class="fieldset">
  <legend class="fieldset-legend">Sources, one URL per line (optional)</legend>
  <%= text_area_tag :sources, local_assigns[:sources], class: "textarea w-full", rows: 2, id: nil %>
</fieldset>
