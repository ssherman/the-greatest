<div class="card bg-base-100 border border-base-300" data-testid="description-card-<%= description.id %>">
  <div class="card-body p-4 gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <span class="badge badge-outline">
        <%= description.source_other? ? description.source_name : description.source.humanize %>
      </span>
      <% if description.preferred? %>
        <span class="badge badge-primary">Preferred</span>
      <% end %>
      <% if description.deprecated? %>
        <span class="badge badge-ghost">Deprecated</span>
      <% end %>
    </div>

    <p class="whitespace-pre-wrap text-sm"><%= description.content %></p>

    <div class="card-actions justify-end">
      <% unless description.preferred? %>
        <%= button_to "Make preferred", set_preferred_admin_description_path(description),
            method: :post, class: "btn btn-xs btn-primary" %>
      <% end %>

      <button type="button"
              class="btn btn-xs"
              onclick="edit_description_<%= description.id %>_modal.showModal()">
        Edit
      </button>

      <%= button_to "Delete", admin_description_path(description),
          method: :delete,
          class: "btn btn-xs btn-error",
          data: {turbo_confirm: "Delete this description?"} %>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<dialog id="edit_description_<%= description.id %>_modal" class="modal">
  <div class="modal-box">
    <h3 class="font-bold text-lg">Edit Description</h3>

    <%= form_with model: description,
                  url: admin_description_path(description),
                  method: :patch,
                  namespace: "description_#{description.id}",
                  class: "space-y-4 mt-4",
                  data: {
                    controller: "modal-form",
                    modal_form_modal_id_value: "edit_description_#{description.id}_modal"
                  } do |f| %>
      <%= render "admin/descriptions/form_fields", f: f %>

      <div class="modal-action">
        <button type="button" class="btn" onclick="edit_description_<%= description.id %>_modal.close()">Cancel</button>
        <%= f.submit "Save Changes", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
