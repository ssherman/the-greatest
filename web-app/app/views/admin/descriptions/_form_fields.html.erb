<div>
  <%= f.label :content, class: "label" do %>
    <span class="font-semibold">Content <span class="text-error">*</span></span>
  <% end %>
  <%= f.text_area :content, class: "textarea w-full h-32", required: true %>
</div>

<div>
  <%= f.label :source, class: "label" do %>
    <span class="font-semibold">Source <span class="text-error">*</span></span>
  <% end %>
  <%= f.select :source, Description.sources.keys.map { |s| [s.humanize, s] },
      {}, class: "select w-full", required: true,
      data: {conditional_field_target: "select", action: "change->conditional-field#toggle"} %>
</div>

<div data-conditional-field-target="field">
  <%= f.label :source_name, class: "label" do %>
    <span class="font-semibold">Source Name</span>
  <% end %>
  <%= f.text_field :source_name, class: "input w-full" %>
  <label class="label">
    <span>Shown only when Source is "Other"</span>
  </label>
</div>

<div>
  <%= f.label :source_url, class: "label" do %>
    <span class="font-semibold">Source URL</span>
  <% end %>
  <%= f.url_field :source_url, class: "input w-full" %>
</div>

<div>
  <%= f.label :license, class: "label" do %>
    <span class="font-semibold">License</span>
  <% end %>
  <%= f.select :license, Description.licenses.keys.map { |l| [l.humanize, l] },
      {include_blank: "Not recorded"}, class: "select w-full" %>
</div>
