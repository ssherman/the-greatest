<%
  heading, message = case @refusal
  when :admin_required
    ["Admin access needed", "This app is asking for admin access to #{domain_name}, and your account does not have it."]
  when :scope_unavailable
    ["Access not available", "This app asked for access that this address does not offer."]
  else
    ["Membership needed", "Connecting an app is part of membership, and your account does not have an active one. Membership covers every site."]
  end
%>
<% content_for :page_title, "#{heading} | #{domain_name}" %>

<div class="mx-auto max-w-lg">
  <div class="card bg-base-100 border border-base-300 shadow-sm" data-testid="oauth-refusal-<%= @refusal %>">
    <div class="card-body gap-4">
      <h1 class="card-title text-2xl"><%= heading %></h1>

      <%= render "oauth/authorizations/destination" %>

      <p><%= message %></p>

      <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
        <%= form_with url: oauth_authorize_path, method: :delete, data: {turbo: false}, class: "w-full sm:w-auto" do %>
          <%= render "oauth/authorizations/request_fields" %>
          <button type="submit" class="btn w-full sm:w-auto" data-testid="oauth-deny">Return to the app</button>
        <% end %>
        <% if @refusal == :membership_required %>
          <%= link_to "See membership", "/membership", class: "btn btn-primary w-full sm:w-auto" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
