<%
  content_for :page_title, "#{@list.name} - My Lists"
  table_layout = UserLists::Show::ItemComponent.table_layout?(
    listable_class: @list.class.listable_class, view_mode: @view_mode
  )
  # Only listables with covers get the grid/table view modes; songs are always
  # tabular, so the switcher is hidden for them.
  show_view_switcher = UserLists::Show::ItemComponent.card_capable?(@list.class.listable_class)
  show_completed = @list.completed_on_enabled?
  # "position" is the default, so it stays out of the URL.
  sort_param = (@sort == "position") ? nil : @sort
  sort_options = [["Your order", nil]]
  sort_options << ["Recently added", "added"]
  sort_options << ["Ranking", "ranking"] if @ranking_available
%>

<div class="container mx-auto px-4 py-8" data-controller="user-list-completion">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
      <% if @owner %>
        <%= link_to my_lists_path,
              class: "text-sm text-base-content/60 hover:text-primary",
              data: { testid: "back-to-lists" } do %>
          ← My Lists
        <% end %>
      <% end %>
      <h1 class="text-3xl font-bold"><%= @list.name %></h1>
      <% if !@owner && @list.user.display_name.present? %>
        <p class="text-sm text-base-content/60" data-testid="list-owner">
          A list by <%= @list.user.display_name %>
        </p>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3" data-testid="list-toolbar">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Sort</span>
        <div class="join">
          <% sort_options.each do |label, value| %>
            <%= link_to label, my_list_path(@list, view_mode: @view_mode, sort: value),
                  class: "join-item btn btn-sm #{(sort_param == value) ? "btn-primary" : "btn-outline"}" %>
          <% end %>
        </div>
      </div>

      <% if show_view_switcher %>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wide text-base-content/50">View</span>
          <div class="join">
            <% UserList::VIEW_MODE_LABELS.each do |mode, label| %>
              <%= link_to label,
                    my_list_path(@list, view_mode: mode, sort: sort_param),
                    class: "join-item btn btn-sm #{(@view_mode == mode) ? "btn-primary" : "btn-outline"}" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @owner %>
        <%= link_to "Edit list", edit_my_list_path(@list), class: "btn btn-sm btn-outline", data: {testid: "edit-list"} %>
      <% end %>

      <div class="ml-auto">
        <%= render CsvExports::DownloadButtonComponent.new(
              export_path: my_list_path(@list, format: :csv, view_mode: @view_mode, sort: sort_param),
              noun: "items",
              capped: false
            ) %>
      </div>
    </div>
  </div>

  <% if @owner %>
    <%= render UserLists::FavoritesNoteComponent.new(user_list: @list) %>
    <%= render UserLists::Show::AddItemComponent.new(list: @list) %>
  <% end %>

  <%# Only this frame reloads after an add (user-list-add-item controller calls %>
  <%# frame.reload), so the page doesn't flash and the success toast stays up. %>
  <%= turbo_frame_tag "list_items", target: "_top", data: {turbo_action: "advance"} do %>
    <p class="text-sm text-base-content/60 mb-4" data-testid="list-item-count">
      <%= pluralize(@pagy.count, "item") %>
    </p>

    <% if @pagy.count.zero? %>
      <div class="text-center py-16" data-testid="empty-list">
        <p class="text-base-content/70">No items in this list yet.</p>
      </div>
    <% else %>
      <% if @pagy.pages > 1 %>
        <div class="flex justify-center mb-6"><%== @pagy.series_nav(anchor_string: 'data-turbo-frame="list_items"') %></div>
      <% end %>

      <% if table_layout %>
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th class="text-center">#</th>
                <th>Title</th>
                <th>By</th>
                <th>Year</th>
                <% if show_completed %><th><%= @list.completion_label %></th><% end %>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @items.each_with_index do |item, index| %>
                <%= render UserLists::Show::ItemComponent.new(item: item, view_mode: @view_mode, position: item.position, index: index, completion_editable: @owner && show_completed) %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="<%= UserLists::Show::ItemComponent.grid_container_class(@list.class.listable_class) %>">
          <% @items.each_with_index do |item, index| %>
            <%= render UserLists::Show::ItemComponent.new(item: item, view_mode: @view_mode, position: item.position, index: index, completion_editable: @owner && show_completed) %>
          <% end %>
        </div>
      <% end %>

      <% if @pagy.pages > 1 %>
        <div class="flex justify-center mt-6"><%== @pagy.series_nav(anchor_string: 'data-turbo-frame="list_items"') %></div>
      <% end %>
    <% end %>
  <% end %>

  <% if @owner && show_completed %>
    <%= render UserLists::Show::CompletionDialogComponent.new %>
  <% end %>
</div>
