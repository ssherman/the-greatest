<% content_for :page_title, "Edit #{@list.name} - My Lists" %>

<div class="container mx-auto max-w-3xl px-4 py-8" data-controller="user-list-completion user-list-edit"
     data-user-list-edit-move-url-value="<%= move_my_list_item_path(@list, "__ID__") %>"
     data-user-list-edit-page-value="<%= @pagy.page %>">
  <div class="mb-6">
    <%= link_to my_list_path(@list), class: "text-sm text-base-content/60 hover:text-primary", data: {testid: "back-to-list"} do %>
      ← Back to list
    <% end %>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold"><%= @list.name %></h1>
      <% if @list.default? %>
        <span class="badge badge-ghost gap-1"><%= icon "lock", library: "lucide", class: "size-3" %>Built-in</span>
      <% end %>
    </div>
  </div>

  <%= render UserLists::FavoritesNoteComponent.new(user_list: @list) %>
  <%= render UserLists::Edit::DetailsFormComponent.new(user_list: @list) %>

  <%= render UserLists::Edit::RowsComponent.new(user_list: @list, items: @items, pagy: @pagy) %>

  <% unless @list.default? %>
    <%# The Delete button lives in the details card and submits this form via its form attribute. %>
    <%= form_with url: my_list_path(@list), method: :delete, id: "delete-list-form", class: "hidden",
          data: {turbo_confirm: "Delete “#{@list.name}”? This removes the list and all its items. It can't be undone."} do %>
    <% end %>
  <% end %>

  <% if @list.completed_on_enabled? %>
    <%= render UserLists::Show::CompletionDialogComponent.new %>
  <% end %>
</div>
