<% content_for :page_title, "Edit #{@list.name} - My Lists" %>

<div class="container mx-auto max-w-3xl px-4 py-8" data-controller="user-list-completion user-list-edit user-list-position"
     data-user-list-position-url-value="<%= move_my_list_item_path(@list, "__ID__") %>"
     data-user-list-edit-move-url-value="<%= move_my_list_item_path(@list, "__ID__") %>"
     data-user-list-edit-page-value="<%= @pagy.page %>">
  <div class="mb-6">
    <%= link_to my_list_path(@list), class: "text-sm text-base-content/60 hover:text-primary", data: {testid: "back-to-list"} do %>
      ← Back to list
    <% end %>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold [overflow-wrap:anywhere]"><span id="list-name-heading"><%= @list.name %></span></h1>
      <% if @list.default? %>
        <span class="badge badge-ghost gap-1"><%= icon "lock", library: "lucide", class: "size-3", aria_hidden: "true" %>Built-in</span>
      <% end %>
    </div>
  </div>

  <%= render UserLists::FavoritesNoteComponent.new(user_list: @list) %>
  <%= render UserLists::Edit::DetailsFormComponent.new(user_list: @list) %>

  <%= render UserLists::Edit::RowsComponent.new(user_list: @list, items: @items, pagy: @pagy) %>

  <% unless @list.default? %>
    <%= render "my_lists/delete_form", list: @list %>
  <% end %>

  <%= render UserLists::Edit::PositionDialogComponent.new(user_list: @list, page: @pagy.page, item_count: @pagy.count) %>

  <% if @list.completed_on_enabled? %>
    <%= render UserLists::Show::CompletionDialogComponent.new %>
  <% end %>
</div>
